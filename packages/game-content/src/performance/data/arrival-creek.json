{
  "id": "arrival-creek",
  "title": "许伯指路",
  "requires": [
    "name"
  ],
  "cast": {
    "player": {
      "name": "{name}"
    },
    "neighbor": {
      "name": "许伯"
    }
  },
  "cues": [
    {
      "type": "scene",
      "alt": "许伯站在洞口，指着溪水与远处通向山门的道路。"
    },
    {
      "type": "title",
      "kicker": "洞口 · 山路",
      "text": "许伯指路"
    },
    {
      "type": "narration",
      "text": "回到洞口，许伯正蹲着系鞋带。他站起身，指向山下那道溪水。"
    },
    {
      "type": "line",
      "speaker": "neighbor",
      "text": "沿溪往下是青溪坡，再往远处走，就能找到诸宗山门。先在舆图上认好位置，别到了岔路才想起问路。"
    },
    {
      "type": "line",
      "speaker": "player",
      "text": "我想找个地方学些本事，可我是新人，宗门愿意收吗？"
    },
    {
      "type": "line",
      "speaker": "neighbor",
      "text": "各家有各家的入门条件。看清楚，再选一家愿意接纳你、也合你心意的。到了山门，有不懂的就问接引人。"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "宗门能教我些什么？",
          "jump": "ask"
        },
        {
          "label": "先看看舆图",
          "jump": "map"
        }
      ]
    },
    {
      "type": "mark",
      "id": "ask"
    },
    {
      "type": "line",
      "speaker": "neighbor",
      "text": "心法、神通，还有炼丹炼器。门里有人带你练，也有差事可接。不懂的，找前辈问就是了。"
    },
    {
      "type": "mark",
      "id": "map"
    },
    {
      "type": "narration",
      "text": "你摊开舆图，先找天南与太岳山，再沿着溪水辨认青溪坡和山门的位置。"
    },
    {
      "type": "end",
      "outcome": "slope"
    }
  ]
}
