        "name": "你"
      },
      "he": {
        "name": "阿禾"
      }
    },
    "cues": [
      {
        "type": "scene",
        "alt": "故乡 · 渡船"
      },
      {
        "type": "title",
        "kicker": "报个名字",
        "text": "早渡"
      },
      {
        "type": "narration",
        "text": "你收下路帖，在客簿上写了名字。阿禾叫你明早来得早些，船要赶在药铺开门前靠岸。"
      },
      {
        "type": "scene",
        "alt": "故乡 · 灶边"
      },
      {
        "type": "narration",
        "text": "回家揭开碗，煎焦的鱼皮已经粘在碗边。你挑完刺，照旧分了半条给咪咪。趁它吃鱼，你把膝盖敷上，收拾了明早要带的东西。"
      },
      {
        "type": "scene",
        "alt": "故乡 · 早渡"
      },
      {
        "type": "narration",
        "text": "天刚亮，你就到了渡口。阿禾已经在按客簿点名了。"
      },
      {
        "type": "end",
        "outcome": "done"
      }
    ]
  }
]
