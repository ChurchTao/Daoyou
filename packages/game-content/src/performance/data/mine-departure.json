    "requires": [],
    "cast": {
      "player": {
        "name": "你"
      },
      "he": {
        "name": "阿禾"
      }
    },
    "cues": [
      {
        "type": "scene",
        "alt": "故乡 · 渡船"
      },
      {
        "type": "title",
        "kicker": "报个名字",
        "text": "早渡"
      },
      {
        "type": "narration",
        "text": "你收下路帖，在客簿上写了名字。阿禾叫你明早来得早些，船要赶在药铺开门前靠岸。"
      },
      {
        "type": "scene",
        "alt": "故乡 · 灶边"
      },
      {
        "type": "narration",
        "text": "灶边那只碗还扣着。你揭开来，鱼皮焦的那一角已经粘在了碗边。你给咪咪挑好刺，照旧分了它半条。它低头吃鱼，你把膝盖敷上，收拾起明早要带的东西。"
      },
      {
        "type": "scene",
        "alt": "故乡 · 早渡"
      },
      {
        "type": "narration",
        "text": "天一亮，阿禾就在渡口点名。你揣好路帖，抱紧咪咪，等他叫到你。"
      },
      {
        "type": "end",
        "outcome": "done"
      }
    ]
  }
]
