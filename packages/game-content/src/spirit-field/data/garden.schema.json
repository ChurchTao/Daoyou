{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "offlineCapMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 2592000000,
      "description": "每株最多积蓄的生产时间，单位毫秒。"
    },
    "collectionLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "species": {
      "minItems": 1,
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "永久物种身份；发布后不要改名或复用。"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "成株名称；灵种名称由此统一生成“成株名称的种子”。"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "quality": {
            "type": "string",
            "enum": [
              "凡品",
              "灵品",
              "玄品",
              "真品",
              "地品",
              "天品",
              "仙品",
              "神品"
            ],
            "description": "物种固有品阶，每阶有独立物种。"
          },
          "element": {
            "type": "string",
            "enum": ["金", "木", "水", "火", "土", "风", "雷", "冰"]
          },
          "legacySpeciesId": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "旧八物种的兼容归属，同品阶内不可重复。"
          },
          "portrait": {
            "type": "object",
            "properties": {
              "atlas": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^botanical-[a-z0-9-]+$"
              },
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7,
                "description": "四列两行图谱的格位，从左到右、从上到下编号 0—7。"
              }
            },
            "required": ["atlas", "index"],
            "additionalProperties": false
          },
          "matureMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 2592000000,
            "description": "凡品基准成株时间，单位毫秒。"
          },
          "branchMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 2592000000,
            "description": "凡品基准蕴灵定向时间，单位毫秒。"
          },
          "evolveMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 2592000000,
            "description": "凡品基准蜕变时间，单位毫秒。"
          },
          "baseOutput": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "kind": {
                "type": "string",
                "enum": ["herb", "tcdb", "spirit_fruit"]
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "cycleMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 2592000000,
                "description": "凡品基准生产周期，单位毫秒；运行时按原种品质倍率缩放。"
              },
              "fruitEffects": {
                "description": "仅灵果填写。最多三种药性，share 合计为 1，共享原有单效灵果强度。灵兽修为不可与人物药性组合。",
                "minItems": 1,
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "family": {
                      "type": "string",
                      "enum": [
                        "healing",
                        "mana",
                        "detox",
                        "cultivation",
                        "beast_cultivation",
                        "insight",
                        "breakthrough",
                        "tempering",
                        "marrow_wash",
                        "longevity"
                      ]
                    },
                    "share": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": ["family", "share"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["name", "description", "kind", "quantity", "cycleMs"],
            "additionalProperties": false
          },
          "branches": {
            "type": "object",
            "properties": {
              "abundance": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "output": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "kind": {
                        "type": "string",
                        "enum": ["herb", "tcdb", "spirit_fruit"]
                      },
                      "quantity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000
                      },
                      "cycleMs": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 2592000000,
                        "description": "凡品基准生产周期，单位毫秒；运行时按原种品质倍率缩放。"
                      },
                      "fruitEffects": {
                        "description": "仅灵果填写。最多三种药性，share 合计为 1，共享原有单效灵果强度。灵兽修为不可与人物药性组合。",
                        "minItems": 1,
                        "maxItems": 3,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "family": {
                              "type": "string",
                              "enum": [
                                "healing",
                                "mana",
                                "detox",
                                "cultivation",
                                "beast_cultivation",
                                "insight",
                                "breakthrough",
                                "tempering",
                                "marrow_wash",
                                "longevity"
                              ]
                            },
                            "share": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "maximum": 1
                            }
                          },
                          "required": ["family", "share"],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "name",
                      "description",
                      "kind",
                      "quantity",
                      "cycleMs"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": ["name", "description", "output"],
                "additionalProperties": false
              },
              "essence": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "output": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "kind": {
                        "type": "string",
                        "enum": ["herb", "tcdb", "spirit_fruit"]
                      },
                      "quantity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000
                      },
                      "cycleMs": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 2592000000,
                        "description": "凡品基准生产周期，单位毫秒；运行时按原种品质倍率缩放。"
                      },
                      "fruitEffects": {
                        "description": "仅灵果填写。最多三种药性，share 合计为 1，共享原有单效灵果强度。灵兽修为不可与人物药性组合。",
                        "minItems": 1,
                        "maxItems": 3,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "family": {
                              "type": "string",
                              "enum": [
                                "healing",
                                "mana",
                                "detox",
                                "cultivation",
                                "beast_cultivation",
                                "insight",
                                "breakthrough",
                                "tempering",
                                "marrow_wash",
                                "longevity"
                              ]
                            },
                            "share": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "maximum": 1
                            }
                          },
                          "required": ["family", "share"],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "name",
                      "description",
                      "kind",
                      "quantity",
                      "cycleMs"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": ["name", "description", "output"],
                "additionalProperties": false
              }
            },
            "required": ["abundance", "essence"],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "quality",
          "element",
          "legacySpeciesId",
          "portrait",
          "matureMs",
          "branchMs",
          "evolveMs",
          "baseOutput",
          "branches"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "offlineCapMs", "collectionLimit", "species"],
  "additionalProperties": false
}
