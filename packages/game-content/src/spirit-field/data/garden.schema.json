{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "offlineCapMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 2592000000,
      "description": "每株最多积蓄的生产时间，单位毫秒。"
    },
    "collectionLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "productionByQuality": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "凡品",
          "灵品",
          "玄品",
          "真品",
          "地品",
          "天品",
          "仙品",
          "神品"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "herbCycleMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 2419200000,
            "description": "实际生产周期，单位毫秒；不再按品质倍率缩放，最长为二十八天有效生产寿命。"
          },
          "fruitCycleMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 2419200000,
            "description": "实际生产周期，单位毫秒；不再按品质倍率缩放，最长为二十八天有效生产寿命。"
          },
          "treasureCycleMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 2419200000,
            "description": "实际生产周期，单位毫秒；不再按品质倍率缩放，最长为二十八天有效生产寿命。"
          }
        },
        "required": [
          "herbCycleMs",
          "fruitCycleMs",
          "treasureCycleMs"
        ],
        "additionalProperties": false
      },
      "required": [
        "凡品",
        "灵品",
        "玄品",
        "真品",
        "地品",
        "天品",
        "仙品",
        "神品"
      ],
      "description": "按实际产物品质选择周期；基础药材每轮一份、繁茂药材两份、灵果及天材地宝各一份。"
    },
    "species": {
      "minItems": 32,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "永久物种身份；发布后不要改名或复用。"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "成株名称；灵种名称由此统一生成“成株名称的种子”。"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "quality": {
            "type": "string",
            "enum": [
              "凡品",
              "灵品",
              "玄品",
              "真品",
              "地品",
              "天品",
              "仙品",
              "神品"
            ],
            "description": "物种固有品阶，每阶有独立物种。"
          },
          "element": {
            "type": "string",
            "enum": [
              "金",
              "木",
              "水",
              "火",
              "土",
              "风",
              "雷",
              "冰"
            ]
          },
          "growthForm": {
            "type": "string",
            "enum": [
              "herb",
              "flower",
              "vine",
              "shrub",
              "tree",
              "fungus",
              "aquatic",
              "root"
            ]
          },
          "harvestPart": {
            "type": "string",
            "enum": [
              "leaf",
              "flower",
              "fruit",
              "root",
              "rhizome",
              "whole",
              "spore",
              "seedpod"
            ]
          },
          "portrait": {
            "type": "object",
            "properties": {
              "atlas": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^botanical-[a-z0-9-]+$",
                "description": "四列四行图谱，行序为幼苗、成株、蕴灵、蜕变。"
              },
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3,
                "description": "图谱列号，从左到右编号 0—3。"
              }
            },
            "required": [
              "atlas",
              "index"
            ],
            "additionalProperties": false
          },
          "matureMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 2592000000,
            "description": "幼苗至可付费成株的实际等待时间，单位毫秒。"
          },
          "branchMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 2592000000,
            "description": "付费成株后至可定向的凡品基准等待时间，单位毫秒。"
          },
          "evolveMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 2592000000,
            "description": "付费定向后至可尝试蜕变的凡品基准等待时间，单位毫秒。"
          },
          "baseOutput": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "kind": {
                "type": "string",
                "enum": [
                  "herb",
                  "tcdb",
                  "spirit_fruit"
                ]
              },
              "fruitEffects": {
                "description": "仅灵果填写。最多三种药性，share 合计为 1，共享原有单效灵果强度。灵兽修为不可与人物药性组合。",
                "minItems": 1,
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "family": {
                      "type": "string",
                      "enum": [
                        "healing",
                        "mana",
                        "detox",
                        "cultivation",
                        "beast_cultivation",
                        "insight",
                        "breakthrough",
                        "tempering",
                        "marrow_wash",
                        "longevity"
                      ]
                    },
                    "share": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "family",
                    "share"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "name",
              "description",
              "kind"
            ],
            "additionalProperties": false
          },
          "branches": {
            "type": "object",
            "properties": {
              "abundance": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "output": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "herb",
                          "tcdb",
                          "spirit_fruit"
                        ]
                      },
                      "fruitEffects": {
                        "description": "仅灵果填写。最多三种药性，share 合计为 1，共享原有单效灵果强度。灵兽修为不可与人物药性组合。",
                        "minItems": 1,
                        "maxItems": 3,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "family": {
                              "type": "string",
                              "enum": [
                                "healing",
                                "mana",
                                "detox",
                                "cultivation",
                                "beast_cultivation",
                                "insight",
                                "breakthrough",
                                "tempering",
                                "marrow_wash",
                                "longevity"
                              ]
                            },
                            "share": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "maximum": 1
                            }
                          },
                          "required": [
                            "family",
                            "share"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "name",
                      "description",
                      "kind"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "name",
                  "description",
                  "output"
                ],
                "additionalProperties": false
              },
              "essence": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "output": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "herb",
                          "tcdb",
                          "spirit_fruit"
                        ]
                      },
                      "fruitEffects": {
                        "description": "仅灵果填写。最多三种药性，share 合计为 1，共享原有单效灵果强度。灵兽修为不可与人物药性组合。",
                        "minItems": 1,
                        "maxItems": 3,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "family": {
                              "type": "string",
                              "enum": [
                                "healing",
                                "mana",
                                "detox",
                                "cultivation",
                                "beast_cultivation",
                                "insight",
                                "breakthrough",
                                "tempering",
                                "marrow_wash",
                                "longevity"
                              ]
                            },
                            "share": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "maximum": 1
                            }
                          },
                          "required": [
                            "family",
                            "share"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "name",
                      "description",
                      "kind"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "name",
                  "description",
                  "output"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "abundance",
              "essence"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "quality",
          "element",
          "growthForm",
          "harvestPart",
          "portrait",
          "matureMs",
          "branchMs",
          "evolveMs",
          "baseOutput",
          "branches"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "offlineCapMs",
    "collectionLimit",
    "productionByQuality",
    "species"
  ],
  "additionalProperties": false
}
