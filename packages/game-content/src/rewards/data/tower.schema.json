{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "number",
      "const": 3
    },
    "contentRevision": {
      "minimum": 1,
      "$ref": "#/$defs/__schema0"
    },
    "pools": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "beast_book",
              "blueprint"
            ]
          },
          "entries": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema1"
            }
          }
        },
        "required": [
          "label",
          "kind",
          "entries"
        ],
        "additionalProperties": false
      }
    },
    "floors": {
      "minItems": 20,
      "maxItems": 20,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    }
  },
  "required": [
    "formatVersion",
    "contentRevision",
    "pools",
    "floors"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "__schema1": {
      "type": "string"
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "floor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "$ref": "#/$defs/__schema0"
        },
        "spiritStonesPerLevel": {
          "$ref": "#/$defs/__schema0"
        },
        "reputation": {
          "$ref": "#/$defs/__schema0"
        },
        "drops": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema3"
          }
        }
      },
      "required": [
        "floor",
        "spiritStonesPerLevel",
        "reputation",
        "drops"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99,
          "$ref": "#/$defs/__schema0"
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "item"
                },
                "definitionId": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "definitionId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "pool"
                },
                "poolId": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "poolId"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "chance",
        "quantity",
        "source"
      ],
      "additionalProperties": false
    }
  }
}
