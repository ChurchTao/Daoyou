{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "number",
      "const": 2
    },
    "contentRevision": {
      "minimum": 1,
      "$ref": "#/$defs/__schema0"
    },
    "poolVersion": {
      "minimum": 1,
      "$ref": "#/$defs/__schema0"
    },
    "bonusPoolVersion": {
      "minimum": 1,
      "$ref": "#/$defs/__schema0"
    },
    "superiorBooks": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "books": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "sources": {
      "type": "object",
      "properties": {
        "exploration": {
          "$ref": "#/$defs/__schema3"
        },
        "battle": {
          "$ref": "#/$defs/__schema3"
        },
        "completion": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": ["exploration", "battle", "completion"],
      "additionalProperties": false
    }
  },
  "required": [
    "formatVersion",
    "contentRevision",
    "poolVersion",
    "bonusPoolVersion",
    "superiorBooks",
    "books",
    "sources"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "__schema1": {
      "type": "string",
      "minLength": 1
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "rewardId": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "minimum": 1,
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": ["rewardId", "weight"],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dailyExpFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stoneHours": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99,
          "$ref": "#/$defs/__schema0"
        },
        "bonusChances": {
          "type": "object",
          "properties": {
            "originDew": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "superiorOriginDew": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "superiorBook": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "blueprint": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "originDew",
            "superiorOriginDew",
            "superiorBook",
            "blueprint"
          ],
          "additionalProperties": false
        },
        "weights": {
          "type": "object",
          "properties": {
            "material": {
              "$ref": "#/$defs/__schema0"
            },
            "blueprint": {
              "$ref": "#/$defs/__schema0"
            },
            "book": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": ["material", "blueprint", "book"],
          "additionalProperties": false
        }
      },
      "required": [
        "chance",
        "dailyExpFraction",
        "stoneHours",
        "quantity",
        "bonusChances",
        "weights"
      ],
      "additionalProperties": false
    }
  }
}
