              "type": "modifyResource",
              "resourceId": "wuxiang.resource.fierce",
              "amount": 3,
              "mode": "set"
            },
            {
              "type": "modifyResource",
              "resourceId": "wuxiang.resource.still",
              "amount": 0,
              "mode": "set"
            },
            {
