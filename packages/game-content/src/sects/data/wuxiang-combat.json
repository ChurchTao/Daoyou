                {
                  "type": "applyStatus",
                  "statusId": "wuxiang.status.demon",
                  "duration": "(3 + fact.wuxiang_b + if(fact.wuxiang_b == 3, 2, 0)) * (1 + known.wuxiang.passive.wrath.6.3 * if(fact.wuxiang_a == 3, 1, 0) * fact.wuxiang_done0 * fact.wuxiang_done1 * fact.wuxiang_done2 * fact.wuxiang_done3)"
                }
              ],
              "failureEffects": [
                {
                  "type": "applyStatus",
                  "statusId": "wuxiang.status.buddha",
                  "duration": "(3 + fact.wuxiang_b + if(fact.wuxiang_b == 3, 2, 0)) * (1 + known.wuxiang.passive.wrath.6.3 * if(fact.wuxiang_a == 3, 1, 0) * fact.wuxiang_done0 * fact.wuxiang_done1 * fact.wuxiang_done2 * fact.wuxiang_done3)"
                }
              ]
            },
            {
              "type": "modifyCooldown",
              "skillId": "wuxiang.skill.restore",
              "amount": -150
            },
            {
              "type": "modifyFact",
              "key": "wuxiang_initiative_round",
              "value": "if(known.wuxiang.passive.wrath.2.3, round + 1, 0)"
