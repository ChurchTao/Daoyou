    {
      "id": "wuxiang.skill.pierce",
      "name": "破妄指",
      "school": "wuxiang",
      "description": "一指破妄，直指本相。\n造成固定伤害。对战人物时攻击一人。对战生灵时，心法达到39级攻击两人，达到60级攻击三人。本相施放成功后获得1枚烈念。",
      "tags": [
        "spell",
        "support"
      ],
      "targeting": {
        "side": "enemy",
        "mode": "fill",
        "count": "if(enemyPlayers > 0, 1, if(skillLevel >= 60, 3, if(skillLevel >= 39, 2, 1)))"
      },
      "effects": [
        {
          "type": "fixedHit",
          "power": "20 + skillLevel * 2.45 + physicalAtk / 3"
        }
      ],
      "formula": "fixed",
      "costMp": "30 * targets"
    },
    {
