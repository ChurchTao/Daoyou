      "description": "甘露回润，同门得济。\n为友方恢复气血。显相时最多治疗三人，并额外治疗持有[[wuxiang.status.vow]]的友方。本相施放成功后获得1枚寂念。",
      "tags": [
        "spell",
        "support"
      ],
      "targeting": {
        "side": "ally",
        "mode": "fill",
        "count": "1 + fact.wuxiang_form * min(3, floor(skillLevel / 40))",
        "includeOwnedStatusKind": "wuxiang.vow"
      },
      "effects": [
        {
          "type": "heal",
          "power": "60 + skillLevel * 2"
        }
      ],
      "costMp": 80
    },
