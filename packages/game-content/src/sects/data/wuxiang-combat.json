              "key": "wuxiang_a",
              "value": "resource.wuxiang.resource.fierce"
            },
            {
              "type": "modifyFact",
              "key": "wuxiang_b",
              "value": "resource.wuxiang.resource.still"
            },
            {
              "type": "modifyFact",
              "key": "wuxiang_form",
              "value": 1
            },
            {
              "type": "modifyFact",
