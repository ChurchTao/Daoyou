          ],
          "when": {
            "pvp": false,
            "oncePerBattle": true,
            "expression": "known.wuxiang.passive.wrath.1.2"
          },
          "aim": "self"
        },
        {
          "on": "onRoundStart",
          "effects": [
            {
              "type": "applyStatus",
              "statusId": "wuxiang.status.initiative",
              "duration": 1
            }
          ],
          "when": {
            "expression": "if(fact.wuxiang_initiative_round == round, 1, 0)"
