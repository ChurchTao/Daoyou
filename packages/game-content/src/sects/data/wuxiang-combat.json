    {
      "id": "wuxiang.skill.pierce",
      "name": "破妄指",
      "school": "wuxiang",
      "description": "一指破妄，直指本相。\n造成固定伤害。对战人物时攻击一名敌人。对战生灵时，破妄指达到39级可攻击两名，达到60级可攻击三名。尚未显相时，成功施放获得1枚烈念。",
      "tags": [
        "spell",
        "support"
      ],
      "targeting": {
        "side": "enemy",
        "mode": "fill",
        "count": "if(enemyPlayers > 0, 1, if(skillLevel >= 60, 3, if(skillLevel >= 39, 2, 1)))"
      },
      "effects": [
        {
          "type": "fixedHit",
          "power": "20 + skillLevel * 2.45 + physicalAtk / 3"
        }
      ],
      "formula": "fixed",
      "costMp": "30 * targets"
    },
    {
      "id": "wuxiang.skill.nectar",
      "name": "甘露愿",
      "school": "wuxiang",
      "description": "甘露回润，同门得济。\n为一名友方恢复气血。显相后，甘露愿每满40级多治疗一名友方，至多额外治疗三名。另可照拂持有你的[[wuxiang.status.vow]]的友方。尚未显相时，成功施放获得1枚寂念。",
      "tags": [
        "spell",
        "support"
      ],
      "targeting": {
        "side": "ally",
        "mode": "fill",
        "count": "1 + fact.wuxiang_form * min(3, floor(skillLevel / 40))",
        "includeOwnedStatusKind": "wuxiang.vow"
      },
      "effects": [
        {
          "type": "heal",
          "power": "60 + skillLevel * 2"
        }
      ],
      "costMp": 80
    },
    {
      "id": "wuxiang.skill.ward",
      "name": "护生愿",
      "school": "wuxiang",
      "description": "护生一愿，伤势暂歇。\n为一名友方施加[[wuxiang.status.ward]]，使其本回合受到的伤害降低，基础降幅为20%。显相后，护生愿每满40级多保护一名友方，至多额外保护三名。另可照拂持有你的[[wuxiang.status.vow]]的友方。尚未显相时，成功施放获得1枚寂念。",
      "tags": [
        "spell",
        "support"
      ],
      "targeting": {
        "side": "ally",
        "mode": "fill",
        "count": "1 + fact.wuxiang_form * min(3, floor(skillLevel / 40)) * (1 - known.wuxiang.passive.compassion.2.3)",
        "includeOwnedStatusKind": "wuxiang.vow"
      },
      "effects": [
        {
          "type": "applyStatus",
          "statusId": "wuxiang.status.ward",
          "duration": 1
        }
      ],
      "costMp": 100
    },
    {
      "id": "wuxiang.skill.empower",
      "name": "破障愿",
      "school": "wuxiang",
      "description": "破障一愿，攻势骤起。\n为一名友方施加[[wuxiang.status.empower]]，使其本回合造成的伤害提高，基础增幅为20%。显相后，破障愿每满40级多强化一名友方，至多额外强化三名。另可照拂持有你的[[wuxiang.status.vow]]的友方。尚未显相时，成功施放获得1枚烈念。",
      "tags": [
        "spell",
        "support"
      ],
      "targeting": {
        "side": "ally",
        "mode": "fill",
        "count": "1 + fact.wuxiang_form * min(3, floor(skillLevel / 40)) * (1 - known.wuxiang.passive.compassion.2.3)",
        "includeOwnedStatusKind": "wuxiang.vow"
      },
      "effects": [
        {
          "type": "applyStatus",
          "statusId": "wuxiang.status.empower",
          "duration": 1
        }
      ],
      "costMp": 100
    },
    {
      "id": "wuxiang.skill.turn",
      "name": "一念回转",
      "school": "wuxiang",
      "description": "一念回转，烈寂互换。\n尚未显相且已有念头时可用。将已积攒的烈念全部转为寂念，寂念全部转为烈念。",
      "tags": [
        "spell",
        "support"
      ],
      "targeting": {
        "side": "self"
      },
      "effects": [
        {
          "type": "modifyFact",
          "key": "wuxiang_swap",
          "value": "resource.wuxiang.resource.fierce"
        },
        {
          "type": "modifyResource",
          "resourceId": "wuxiang.resource.fierce",
          "amount": "resource.wuxiang.resource.still",
          "mode": "set"
        },
        {
          "type": "modifyResource",
          "resourceId": "wuxiang.resource.still",
          "amount": "fact.wuxiang_swap",
          "mode": "set"
        },
        {
          "type": "randomBranch",
          "branchId": "wuxiang.branch.choice",
          "chance": "(known.wuxiang.passive.compassion.5.3+known.wuxiang.passive.wrath.5.3)",
          "successEffects": [
            {
              "type": "randomBranch",
              "branchId": "wuxiang.branch.choice",
              "chance": "resource.wuxiang.resource.fierce >= resource.wuxiang.resource.still",
              "successEffects": [
                {
                  "type": "modifyResource",
                  "resourceId": "wuxiang.resource.fierce",
                  "amount": "min(3 - resource.wuxiang.resource.still, resource.wuxiang.resource.fierce + 1)",
                  "mode": "set"
                }
              ],
              "failureEffects": [
                {
                  "type": "modifyResource",
                  "resourceId": "wuxiang.resource.still",
                  "amount": "min(3 - resource.wuxiang.resource.fierce, resource.wuxiang.resource.still + 1)",
                  "mode": "set"
                }
              ]
            }
          ],
          "failureEffects": []
        }
      ],
      "requirement": "if(fact.wuxiang_form == 0, resource.wuxiang.resource.fierce + resource.wuxiang.resource.still > 0, 0)",
      "costMp": 30
    },
    {
      "id": "wuxiang.skill.restore",
      "name": "返照归真",
      "school": "wuxiang",
      "description": "返照归真，伤损复原。\n回复自身气血，积攒的念头越多，回复越多。尚未显相时，先修复自身伤势再回复气血，成功施放后积1枚寂念。显相时获得[[wuxiang.status.repair_guard]]，并使法相延长1回合。每次显相时，本技能立即结束冷却。",
      "tags": [
        "spell",
        "support"
      ],
      "targeting": {
        "side": "self"
      },
      "effects": [
        {
          "type": "removeWound",
          "power": "level * 2",
          "when": {
            "expression": "fact.wuxiang_form == 0"
          }
        },
        {
          "type": "heal",
          "power": "level * 4 * (1 + (resource.wuxiang.resource.fierce + resource.wuxiang.resource.still) * 0.2)"
        },
        {
          "type": "applyStatus",
          "statusId": "wuxiang.status.repair_guard",
          "duration": 1,
          "when": {
            "expression": "fact.wuxiang_form"
          }
        },
        {
          "type": "modifyStatusDuration",
          "kinds": [
            "wuxiang.form"
          ],
          "amount": 1,
          "when": {
            "expression": "fact.wuxiang_form"
          }
        }
      ],
      "cooldownRounds": 150,
      "costMp": 50
    },
    {
      "id": "wuxiang.skill.strike",
      "name": "摧岳",
      "school": "wuxiang",
      "description": "摧岳一击，势压一人。\n对一名敌人造成物理伤害。显相时基础威力提高40%，烈念的增幅另外计算。尚未显相时，成功施放获得1枚烈念。",
      "tags": [
        "physical"
      ],
      "targeting": {
        "side": "enemy"
      },
      "effects": [
        {
          "type": "physicalHit",
          "coeff": 1,
          "when": {
            "expression": "fact.wuxiang_form == 0"
          }
        },
        {
          "type": "physicalHit",
          "coeff": 1.4,
          "when": {
            "expression": "fact.wuxiang_form"
          }
        }
      ],
      "costMp": 50
