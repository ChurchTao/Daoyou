          "passives": [
            "lingxiao.passive.zhanchen.n5_2"
          ]
        },
        {
          "id": "lingxiao.node.zhanchen.5.3",
          "name": "傲视",
          "layer": 5,
          "slot": 3,
          "description": "你在场存活时，亲自击倒敌方人物后获得[[lingxiao.status.pride]]，物理伤害提高40%，持续3回合。",
          "passives": [
            "lingxiao.passive.zhanchen.n5_3"
          ]
        },
        {
          "id": "lingxiao.node.zhanchen.6.1",
          "name": "破空",
          "layer": 6,
          "slot": 1,
          "description": "若其他敌人为你的攻击目标分担伤害，原目标分到的伤害提高15%。",
          "passives": [
            "lingxiao.passive.zhanchen.n6_1"
          ]
        },
        {
          "id": "lingxiao.node.zhanchen.6.2",
          "name": "历战",
          "layer": 6,
          "slot": 2,
          "description": "施放临渊前，若当前气血低于最大气血的50%，本次临渊伤害提高10%。仍须满足气血要求，复活当回合无法施放。",
          "passives": [
            "lingxiao.passive.zhanchen.n6_2"
          ]
        },
        {
          "id": "lingxiao.node.zhanchen.6.3",
          "name": "安神",
          "layer": 6,
          "slot": 3,
          "description": "剑心通明改为施加强化的[[lingxiao.status.clarity_anshen]]，额外使你受到的法术伤害降低50%，仍持续5回合。",
          "patches": [
            {
              "skillId": "lingxiao.skill.clarity",
              "operation": "replaceStatusId",
              "from": "lingxiao.status.clarity",
              "to": "lingxiao.status.clarity_anshen"
            }
          ]
        },
        {
          "id": "lingxiao.node.zhanchen.7.1",
          "name": "额外能力",
          "layer": 7,
          "slot": 1,
          "description": "贯通第七层后自动获得40点物理攻击。",
          "automatic": true,
          "legacyReplacementId": "lingxiao.node.zhanchen.7.2",
          "panel": [
            {
              "attr": "physicalAtk",
              "mode": "add",
              "value": 40
            }
          ]
        },
        {
          "id": "lingxiao.node.zhanchen.7.2",
          "name": "无敌",
          "layer": 7,
          "slot": 2,
          "description": "断尘由三击增加到四击，四击的伤害系数分别为75%、85%、95%和110%。",
          "patches": [
            {
              "skillId": "lingxiao.skill.triple",
              "operation": "addPhysicalCoefficient",
              "hitIndex": 3,
              "value": 1.1
            }
          ]
        },
        {
          "id": "lingxiao.node.zhanchen.7.3",
          "name": "斩尘证道",
          "layer": 7,
          "slot": 3,
          "description": "贯通第七层后自动获得40点物理攻击及本流派称谓。",
