            "requireKind": "physical"
          },
          "defenseIgnoreAdd": "max(0, fact.weaponXuanfengLevel * 0.5 - 3) / 100"
        }
      ],
      "hooks": []
    },
    {
      "id": "lingxiao.passive.guiyi.n5_3",
      "name": "突进",
      "description": "你的物理攻击每有一击扣除目标气血，本场后续物理攻击就额外获得2点物理攻击。多段攻击按每击累积，附带的溅射伤害不会叠加此效果。",
      "modifiers": [
        {
          "when": {
            "requireKind": "physical"
          },
          "physicalAttackAdd": "resource.lingxiao.resource.advance * 2"
        }
      ],
      "hooks": [
        {
          "on": "afterHit",
          "effects": [
            {
              "type": "modifyResource",
              "resourceId": "lingxiao.resource.advance",
              "amount": 1
            }
          ],
          "sourceIsSelf": true,
          "when": {
            "requireKind": "physical"
          }
        }
      ]
    },
    {
      "id": "lingxiao.passive.guiyi.n6_1",
      "name": "剑破",
      "description": "剑意达到13层时，武器上所有玄锋阵纹提供的物理攻击变为原来的三倍。",
      "modifiers": [
        {
          "when": {
