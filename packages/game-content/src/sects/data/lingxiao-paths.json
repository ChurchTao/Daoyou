  "paths": [
    {
      "id": "lingxiao.path.zhanchen",
      "name": "斩尘证道",
      "description": "侧重物理爆发。经脉强化破防、暴击与击倒后的追击，适合喜欢抓住机会集中出手的修士。",
      "nodes": [
        {
          "id": "lingxiao.node.zhanchen.1.1",
          "name": "目空",
          "layer": 1,
          "slot": 1,
          "description": "使用器诀造成物理伤害、施放惊鸿掠影，或以惊雷蓄势后自动出击时，忽视目标10%的物理防御。",
          "passives": [
            "lingxiao.passive.zhanchen.n1_1"
          ]
        },
        {
          "id": "lingxiao.node.zhanchen.1.2",
          "name": "风刃",
          "layer": 1,
          "slot": 2,
          "description": "与生灵交战时，普通攻击对另外两名随机敌人溅射20%的伤害。自身有[[lingxiao.status.sword_aura]]时，溅射提高到40%。",
          "passives": [
            "lingxiao.passive.zhanchen.n1_2"
          ]
        },
        {
          "id": "lingxiao.node.zhanchen.1.3",
          "name": "扶阵",
          "layer": 1,
          "slot": 3,
          "description": "自身在场存活时，全队总伤害提高3%，同名效果不叠加。",
          "passives": [
            "lingxiao.passive.zhanchen.n1_3"
          ]
        },
        {
          "id": "lingxiao.node.zhanchen.2.1",
          "name": "翩鸿",
          "layer": 2,
          "slot": 1,
          "description": "惊鸿掠影伤害提高35%，命中时随机驱散目标一个可驱散的增益。击倒目标时改为驱散其全部可驱散的增益，本次技能不进入冷却。",
          "passives": [
            "lingxiao.passive.zhanchen.n2_1"
          ]
        },
        {
          "id": "lingxiao.node.zhanchen.2.2",
          "name": "勇武",
          "layer": 2,
          "slot": 2,
          "description": "施放惊雷不再消耗气血，改为回复最大气血的15%（最多人物等级×8），并获得10点战意。下回合自动攻击时，额外造成相当于目标物理防御40%的伤害，命中还会留下[[lingxiao.status.bravery]]。",
          "passives": [
            "lingxiao.passive.zhanchen.n2_2"
          ],
          "patches": [
            {
              "skillId": "lingxiao.skill.waiting",
              "operation": "setCostHp",
              "value": 0
            }
          ]
        },
        {
          "id": "lingxiao.node.zhanchen.2.3",
          "name": "长驱直入",
          "layer": 2,
          "slot": 3,
          "description": "以长驱直入替换惊鸿掠影。造成普通攻击110%的物理伤害，敌人无法替目标分担伤害，命中后有60%概率使目标陷入[[lingxiao.status.wound]]，持续2回合。消耗50法力，冷却6回合。",
          "grantSkills": [
            "lingxiao.skill.zhanchen_long_drive"
          ],
          "revokeSkillIds": [
            "lingxiao.skill.shadow_strike"
          ]
        },
        {
          "id": "lingxiao.node.zhanchen.3.1",
          "name": "杀意",
          "layer": 3,
          "slot": 1,
          "description": "武器、衣服每件属于金、火、风任一行，物理暴击倍率增加0.20，两件可叠加。",
          "passives": [
            "lingxiao.passive.zhanchen.n3_1"
          ]
        },
        {
          "id": "lingxiao.node.zhanchen.3.2",
          "name": "念心",
          "layer": 3,
          "slot": 2,
          "description": "攻击敌方人物时，若其没有在场存活的出战灵兽，你的物理暴击率提高15%。",
          "passives": [
            "lingxiao.passive.zhanchen.n3_2"
          ]
        },
        {
          "id": "lingxiao.node.zhanchen.3.3",
          "name": "静岳",
          "layer": 3,
          "slot": 3,
          "description": "有护盾时，物理暴击率提高4%。回合结束时若你仍在场存活且没有护盾，获得相当于人物等级的护盾。",
          "passives": [
            "lingxiao.passive.zhanchen.n3_3"
          ]
        },
        {
          "id": "lingxiao.node.zhanchen.4.1",
          "name": "干将",
          "layer": 4,
          "slot": 1,
          "description": "破极剑意改为施加强化的[[lingxiao.status.sword_aura_ganjiang]]，使受益者的物理攻击忽视目标15%的物理防御，持续5回合。",
          "patches": [
            {
              "skillId": "lingxiao.skill.sword_aura",
              "operation": "replaceStatusId",
              "from": "lingxiao.status.sword_aura",
              "to": "lingxiao.status.sword_aura_ganjiang"
            }
          ]
        },
        {
          "id": "lingxiao.node.zhanchen.4.2",
          "name": "破血",
          "layer": 4,
          "slot": 2,
          "description": "装备带有器诀「双剑合璧」时，该器诀由两次攻击增加到三次。",
          "passives": [
            "lingxiao.passive.zhanchen.n4_2"
          ]
        },
        {
          "id": "lingxiao.node.zhanchen.4.3",
          "name": "乘势",
          "layer": 4,
          "slot": 3,
          "description": "有[[lingxiao.status.pursuit]]时，断尘可以在低气血时施放，且不消耗气血。",
          "passives": [
            "lingxiao.passive.zhanchen.n4_3"
          ]
        },
        {
          "id": "lingxiao.node.zhanchen.5.1",
          "name": "执剑",
          "layer": 5,
          "slot": 1,
          "description": "队伍只有一名红尘剑宗弟子时，本场首次临渊目标数增加3，且此次临渊暴击率提高10%。",
          "passives": [
            "lingxiao.passive.zhanchen.n5_1"
          ]
        },
        {
          "id": "lingxiao.node.zhanchen.5.2",
          "name": "不惊",
          "layer": 5,
          "slot": 2,
