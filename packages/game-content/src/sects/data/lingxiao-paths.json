    {
      "id": "lingxiao.passive.zhanchen.n1_1",
      "name": "目空",
      "description": "使用器诀造成物理伤害、施放惊鸿掠影，或以惊雷蓄势后自动出击时，忽视目标10%的物理防御。",
      "modifiers": [
        {
          "when": {
            "skillTags": [
              "art"
            ],
            "requireKind": "physical"
          },
          "defenseIgnoreAdd": 0.1
        },
        {
          "when": {
            "skillIds": [
              "lingxiao.skill.shadow_strike"
            ]
          },
          "defenseIgnoreAdd": 0.1
        },
        {
          "when": {
            "skillIds": [
              "attack"
            ],
            "requireStatusIds": [
              "lingxiao.status.waiting"
            ]
          },
          "defenseIgnoreAdd": 0.1
        }
      ],
      "hooks": []
    },
    {
      "id": "lingxiao.passive.zhanchen.n1_2",
      "name": "风刃",
      "description": "与生灵交战时，普通攻击对另外两名随机敌人溅射20%的伤害。自身有[[lingxiao.status.sword_aura]]时，溅射提高到40%。",
      "modifiers": [
        {
          "when": {
            "skillIds": [
              "attack"
            ],
            "pvp": false,
            "requireAbsentStatusIds": [
              "lingxiao.status.sword_aura",
              "lingxiao.status.sword_aura_ganjiang"
            ]
          },
          "splash": {
            "factor": 0.2,
            "count": 2
          }
        },
        {
          "when": {
            "skillIds": [
              "attack"
            ],
            "pvp": false,
            "requireStatusIds": [
              "lingxiao.status.sword_aura",
              "lingxiao.status.sword_aura_ganjiang"
            ]
          },
          "splash": {
            "factor": 0.4,
            "count": 2
          }
        }
      ],
      "hooks": []
    },
    {
      "id": "lingxiao.passive.zhanchen.n1_3",
      "name": "扶阵",
      "description": "自身在场存活时，全队总伤害提高3%，同名效果不叠加。",
      "modifiers": [
        {
          "teamAura": "lingxiao.fuzhen",
          "damageBonus": 0.03
        }
      ],
      "hooks": []
    },
    {
      "id": "lingxiao.passive.zhanchen.n2_1",
      "name": "翩鸿",
      "description": "惊鸿掠影伤害提高35%，命中时随机驱散目标一个可驱散的增益。击倒目标时改为驱散其全部可驱散的增益，本次技能不进入冷却。",
      "modifiers": [
        {
          "when": {
            "skillIds": [
              "lingxiao.skill.shadow_strike"
            ]
          },
          "damageBonus": 0.35,
          "resetCooldownOnKill": true
        }
      ],
      "hooks": [
        {
          "on": "afterStrike",
          "effects": [
            {
              "type": "dispel",
              "categories": [
                "buff"
              ],
              "maxCount": 1,
              "random": true
            }
          ],
          "sourceIsSelf": true,
          "aim": "hookTarget",
          "when": {
            "skillIds": [
              "lingxiao.skill.shadow_strike"
            ]
          }
        },
        {
          "on": "onDeath",
          "effects": [
            {
              "type": "dispel",
              "categories": [
                "buff"
              ]
            }
          ],
          "sourceIsSelf": true,
          "aim": "hookTarget",
          "when": {
            "skillIds": [
              "lingxiao.skill.shadow_strike"
            ]
          }
        }
      ]
    },
    {
      "id": "lingxiao.passive.zhanchen.n2_2",
      "name": "勇武",
      "description": "施放惊雷不再消耗气血，改为回复最大气血的15%（最多人物等级×8），并获得10点战意。下回合自动攻击时，额外造成相当于目标物理防御40%的伤害，命中还会留下[[lingxiao.status.bravery]]。",
      "modifiers": [
        {
          "when": {
            "skillIds": [
              "attack"
            ],
            "requireStatusIds": [
              "lingxiao.status.waiting"
            ]
          },
          "damageAdd": "target.physicalDef * 0.4"
        }
      ],
      "hooks": [
        {
          "on": "afterAction",
          "effects": [
            {
              "type": "restoreHp",
              "power": "min(maxHp * 0.15, level * 8)"
            },
            {
              "type": "modifyResource",
              "resourceId": "combat.resource.rage",
              "amount": 10
            }
          ],
          "sourceIsSelf": true,
          "aim": "self",
          "when": {
            "skillIds": [
              "lingxiao.skill.waiting"
            ],
            "actionSucceeded": true
          }
        },
        {
          "on": "afterStrike",
          "effects": [
            {
              "type": "applyStatus",
              "statusId": "lingxiao.status.bravery",
              "duration": 1
            }
          ],
          "sourceIsSelf": true,
          "aim": "hookTarget",
          "when": {
            "skillIds": [
              "attack"
            ],
            "requireStatusIds": [
              "lingxiao.status.waiting"
            ]
          }
        }
      ]
    },
    {
      "id": "lingxiao.passive.zhanchen.n3_1",
      "name": "杀意",
      "description": "武器、衣服每件属于金、火、风任一行，物理暴击倍率增加0.20，两件可叠加。",
      "modifiers": [
        {
          "when": {
            "requireKind": "physical"
          },
          "critMultiplierAdd": "fact.metalFireWindEquipmentCount * 0.2"
        }
      ],
      "hooks": []
    },
    {
      "id": "lingxiao.passive.zhanchen.n3_2",
      "name": "念心",
      "description": "攻击敌方人物时，若其没有在场存活的出战灵兽，你的物理暴击率提高15%。",
      "modifiers": [
        {
          "when": {
            "requireKind": "physical",
            "foeKind": "player",
            "targetHasStandingPet": false
          },
          "critChanceAdd": 0.15
        }
      ],
      "hooks": []
    },
    {
      "id": "lingxiao.passive.zhanchen.n3_3",
      "name": "静岳",
      "description": "有护盾时，物理暴击率提高4%。回合结束时若你仍在场存活且没有护盾，获得相当于人物等级的护盾。",
      "modifiers": [
        {
          "when": {
            "requireKind": "physical",
            "sourceHasBarrier": true
          },
          "critChanceAdd": 0.04
        }
      ],
      "hooks": [
        {
          "on": "onRoundEnd",
          "effects": [
            {
              "type": "applyBarrier",
              "id": "lingxiao.barrier.jingyue",
              "kind": "lingxiao.jingyue",
              "name": "静岳",
              "power": "level",
              "duration": 1,
              "untilBattleEnd": true
            }
          ],
          "aim": "self",
          "when": {
            "sourceHasBarrier": false,
            "sourceStanding": true
          }
        }
      ]
    },
    {
      "id": "lingxiao.passive.zhanchen.n4_2",
