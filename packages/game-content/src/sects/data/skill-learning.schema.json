{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "contentRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "skills": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]+\\.(skill|passive)\\.[a-z0-9_.]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sourceMethodId": {
            "type": "string",
            "minLength": 1
          },
          "unlockMethodLevel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 180
          }
        },
        "required": [
          "sourceMethodId",
          "unlockMethodLevel"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "formatVersion",
    "contentRevision",
    "skills"
  ],
  "additionalProperties": false
}
