{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "contentRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "sects": {
      "type": "object",
      "properties": {
        "lingxiao": {
          "$ref": "#/$defs/__schema0"
        },
        "youdu": {
          "$ref": "#/$defs/__schema0"
        },
        "wuxiang": {
          "$ref": "#/$defs/__schema0"
        },
        "tianyan": {
          "$ref": "#/$defs/__schema0"
        },
        "jiujie": {
          "$ref": "#/$defs/__schema0"
        },
        "bailu": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "lingxiao",
        "youdu",
        "wuxiang",
        "tianyan",
        "jiujie",
        "bailu"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "formatVersion",
    "contentRevision",
    "sects"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "minItems": 6,
      "maxItems": 6,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+\\.method\\.[a-z_]+$"
        },
        "slot": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            },
            {
              "type": "number",
              "const": 3
            },
            {
              "type": "number",
              "const": 4
            },
            {
              "type": "number",
              "const": 5
            },
            {
              "type": "number",
              "const": 6
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "isPrimary": {
          "type": "boolean"
        },
        "panel": {
          "type": "object",
          "properties": {
            "attr": {
              "type": "string",
              "enum": [
                "hp",
                "maxHp",
                "mp",
                "maxMp",
                "physicalAtk",
                "physicalDef",
                "magicAtk",
                "magicDef",
                "healPower",
                "speed",
                "hit",
                "dodge",
                "critRate",
                "spellCritRate",
                "physicalFuryRate",
                "sealHit",
                "sealResist",
                "attackCultivate",
                "defenseCultivate",
                "spellCultivate",
                "resistSpellCultivate"
              ]
            },
            "mode": {
              "type": "string",
              "enum": [
                "add",
                "multiply"
              ]
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000,
              "multipleOf": 0.000001
            }
          },
          "required": [
            "attr",
            "mode",
            "value"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "slot",
        "name",
        "isPrimary"
      ],
      "additionalProperties": false
    }
  }
}
