    "wanqiao": [
      {
        "id": "wanqiao.method.canon",
        "slot": 1,
        "name": "《听万窍》",
        "description": "初入山门，先学静听。石有隙，竹有窍，人的心念也须留出空处；待自己的声音静下来，才辨得清天地如何应答。",
        "isPrimary": true
