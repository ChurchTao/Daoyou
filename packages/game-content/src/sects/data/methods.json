      },
      {
        "id": "wanqiao.method.rest",
        "slot": 4,
        "name": "《月满空山》",
        "description": "月照空山，草木无言。修者借这一分静意收拢散乱气息，慢慢养稳气血与筋骨；身中有了安处，行止便多一分安定。",
        "isPrimary": false,
        "panel": {
          "attr": "physicalDef",
          "mode": "add",
          "value": 0.4
