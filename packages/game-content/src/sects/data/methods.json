      },
      {
        "id": "wanqiao.method.hollow",
        "slot": 5,
        "name": "《虚舟》",
        "description": "空舟能容物，虚心能应变。修者在来势之间留出转圜，让气息游走于身周，护得住自己，也不失从容。",
        "isPrimary": false,
        "panel": {
          "attr": "dodge",
          "mode": "add",
          "value": 0.3
        }
      },
      {
        "id": "wanqiao.method.breath",
        "slot": 6,
        "name": "《一息绵长》",
        "description": "一呼一吸，细匀绵长。修者涵养胸中灵息，使一段声音止后，仍有余力续起下一段，与身旁的众声相和。",
        "isPrimary": false,
        "panel": {
          "attr": "maxMp",
