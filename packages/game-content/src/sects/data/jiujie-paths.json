              "failureEffects": [
                {
                  "type": "removeStatus",
                  "kinds": [
                    "jiujie.status.red"
                  ],
                  "ownedOnly": true
                },
                {
                  "type": "applyStatus",
                  "statusId": "jiujie.status.electric",
                  "duration": 3
                }
              ]
            }
          ],
          "when": {
            "skillIds": [
              "jiujie.skill.thunderstorm",
              "jiujie.skill.edict",
              "jiujie.skill.six_thunder"
            ],
            "initialTargetStatusKinds": [
              "jiujie.status.electric",
              "jiujie.status.red"
            ],
            "targetEnemy": true
          },
          "sourceIsSelf": true,
          "chance": 0.1,
          "targeting": {
            "side": "enemy",
            "mode": "random",
            "count": 1
          }
        }
      ],
      "description": "万钧雷狱、敕雷或六霄雷劫命中出手前已带有雷印或赤雷印的敌人时，有10%概率随机给一名可被攻击的敌人施加[[jiujie.status.electric]]。"
    },
    {
      "id": "jiujie.passive.shuang",
      "name": "霜雷",
      "modifiers": [
        {
          "when": {
            "requireKind": "spell"
          },
          "damageBonus": 0.05
        }
      ],
      "description": "法术伤害提高5%。"
    },
    {
      "id": "jiujie.passive.hongming",
      "name": "轰鸣",
      "description": "《混天雷法》等级达到或超过人物等级时，法术攻击提高60点。"
    },
    {
      "id": "jiujie.passive.yuyi",
      "name": "驭意",
      "description": "每10点灵力增加0.5点速度和1点法术攻击，同时降低2.4点法术防御。"
    },
    {
      "id": "jiujie.passive.gangwei",
      "name": "罡威",
      "description": "[[jiujie.status.guardian]]提供的法术攻击额外提高50%。"
    },
    {
      "id": "jiujie.passive.six",
      "name": "六霄雷劫",
      "description": "万钧雷狱和敕雷有劫雷灌注时仍可多攻击3人，并保留灌注。获得神通六霄雷劫，消耗1层灌注，对最多6名敌人造成法术伤害，并留下[[jiujie.status.electric]]。"
    },
    {
      "id": "jiujie.passive.chiji",
      "name": "赤殛",
      "description": "若你是队内唯一的九劫天宫修士，施加雷印时有10%概率改为[[jiujie.status.red]]。你对带有自己赤雷印的敌人造成的法术伤害提高70%，命中一次后赤雷印转为普通雷印。"
    },
    {
      "id": "jiujie.passive.lingguang",
