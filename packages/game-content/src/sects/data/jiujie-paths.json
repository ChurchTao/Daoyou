              "successEffects": [
                {
                  "type": "removeStatus",
                  "kinds": [
                    "jiujie.status.electric"
                  ],
                  "ownedOnly": true
                },
                {
                  "type": "applyStatus",
                  "statusId": "jiujie.status.red",
