{
  "$schema": "./jiujie-paths.schema.json",
  "formatVersion": 1,
  "contentRevision": 4,
  "passives": [
    {
      "id": "jiujie.passive.physical",
      "name": "以身承雷",
      "description": "可直接选择震岳或掠霆的一至三重。使用引劫入体获得劫雷灌注后，可消耗1层使攻击提高一重。达到二重及以上时，有概率需要在下回合休息。物理伤害提高10%，法术伤害降低15%，封印命中率变为原来的85%。",
      "modifiers": [
        {
          "when": {
            "requireKind": "physical"
          },
          "damageBonus": 0.1
        },
        {
          "when": {
            "requireKind": "spell"
          },
          "damageBonus": -0.15
        },
        {
          "sealChanceFactor": 0.85
        }
      ]
    },
    {
      "id": "jiujie.passive.magic",
      "name": "以印引劫",
      "hooks": [
        {
          "on": "onRoundStart",
          "effects": [
            {
              "type": "applyStatus",
              "statusId": "jiujie.status.attunement",
              "duration": 1,
              "self": true
            }
          ],
          "when": {
            "oncePerBattle": true
          }
        },
        {
          "on": "afterStrike",
          "effects": [
            {
              "type": "removeStatus",
              "kinds": [
                "jiujie.status.red"
              ],
              "ownedOnly": true
            },
            {
              "type": "applyStatus",
              "statusId": "jiujie.status.electric",
              "duration": 3
            }
          ],
          "when": {
            "targetOwnedStatus": {
              "kind": "jiujie.status.red"
            }
          },
          "sourceIsSelf": true
        },
        {
          "on": "afterStrike",
          "effects": [
            {
              "type": "randomBranch",
              "branchId": "jiujie.branch.red_mark",
              "chance": "known.jiujie.passive.chiji * if(allyTagCount.sect.jiujie == 1, 0.1, 0)",
              "successEffects": [
                {
                  "type": "removeStatus",
                  "kinds": [
                    "jiujie.status.electric"
                  ],
                  "ownedOnly": true
                },
                {
                  "type": "applyStatus",
                  "statusId": "jiujie.status.red",
                  "duration": 3
                }
              ],
              "failureEffects": [
                {
                  "type": "removeStatus",
                  "kinds": [
                    "jiujie.status.red"
                  ],
                  "ownedOnly": true
                },
                {
                  "type": "applyStatus",
                  "statusId": "jiujie.status.electric",
                  "duration": 3
                }
              ]
            }
          ],
          "when": {
            "skillIds": [
              "jiujie.skill.thunderstorm",
              "jiujie.skill.edict",
              "jiujie.skill.six_thunder"
            ],
            "targetEnemy": true,
            "sourceStanding": true
          },
          "sourceIsSelf": true
        }
      ],
      "modifiers": [
        {
          "sealChanceFactor": 0.85
        },
        {
          "when": {
            "requireKind": "spell",
            "targetOwnedStatus": {
              "kind": "jiujie.status.electric"
            },
            "expression": "1 - ownedTargetStatus.jiujie.status.red"
          },
          "damageBonus": 0.12
        },
        {
          "when": {
            "requireKind": "spell",
            "targetOwnedStatus": {
              "kind": "jiujie.status.red"
            }
          },
          "damageBonus": 0.7
        }
      ],
      "description": "万钧雷狱、敕雷和六霄雷劫命中后留下3回合[[jiujie.status.electric]]，你后续对带有自己雷印的敌人造成的法术伤害提高12%。封印命中率变为原来的85%。"
    },
    {
      "id": "jiujie.passive.tingzhen",
      "name": "霆震",
      "modifiers": [
        {
          "when": {
            "skillIds": [
              "jiujie.skill.strike_1",
              "jiujie.skill.strike_2",
              "jiujie.skill.strike_3",
              "jiujie.skill.sweep_1",
              "jiujie.skill.sweep_2",
              "jiujie.skill.sweep_3",
              "jiujie.skill.tribulation"
            ],
            "requireKind": "physical",
            "expression": "(fact.jiujie_type == 2) * (effective.speed > targetEffective.speed)"
          },
          "damageBonus": 0.08
        }
      ],
      "description": "掠霆攻击速度低于自己的目标时，伤害提高8%。"
    },
    {
      "id": "jiujie.passive.jilei",
      "name": "疾雷",
      "modifiers": [
        {
          "when": {
            "skillIds": [
              "jiujie.skill.strike_1",
              "jiujie.skill.strike_2",
              "jiujie.skill.strike_3",
              "jiujie.skill.sweep_1",
              "jiujie.skill.sweep_2",
              "jiujie.skill.sweep_3",
              "jiujie.skill.tribulation"
            ],
            "requireKind": "physical",
            "expression": "(fact.jiujie_type == 1) * (fact.jiujie_rank >= 2) * (fact.jiujie_streak >= 2)"
          },
          "defenseIgnoreAdd": 0.1
        }
      ],
      "description": "在触发休息前累计两次以二重及以上使用震岳、掠霆或九劫归一后，二重及以上的震岳忽略10%物理防御，掠霆的基础休息概率从50%降到40%。效果持续到下次休息。"
    },
    {
      "id": "jiujie.passive.jiyue",
      "name": "激越",
      "modifiers": [
        {
          "when": {
            "skillIds": [
              "jiujie.skill.strike_1",
              "jiujie.skill.strike_2",
              "jiujie.skill.strike_3",
              "jiujie.skill.sweep_1",
              "jiujie.skill.sweep_2",
              "jiujie.skill.sweep_3",
              "jiujie.skill.tribulation"
            ],
            "requireKind": "physical",
            "expression": "(fact.jiujie_type == 1) * (hp > target.hp)"
          },
          "damageBonus": 0.05
        }
      ],
      "description": "震岳攻击当前气血值低于自己的目标时，伤害提高5%。"
    },
    {
      "id": "jiujie.passive.cunxiong",
      "name": "存雄",
      "hooks": [
        {
          "on": "afterAction",
          "effects": [
            {
              "type": "applyStatus",
              "statusId": "jiujie.status.cunxiong",
              "duration": 3,
              "self": true
            }
          ],
          "when": {
            "skillTags": [
              "art"
            ],
            "actionSucceeded": true
          },
          "sourceIsSelf": true
        }
      ],
      "description": "成功使用器诀后获得3回合[[jiujie.status.cunxiong]]，使震岳、掠霆和九劫归一造成的物理伤害提高10%。"
    },
    {
      "id": "jiujie.passive.yuyun",
      "name": "余韵",
      "hooks": [
        {
          "on": "afterAction",
          "effects": [
            {
              "type": "modifyFact",
              "key": "jiujie_echo",
              "value": 1
            }
          ],
          "when": {
            "skillIds": [
              "dao_equipment.skill.diefeng",
              "dao_equipment.skill.cuiling"
            ],
            "actionSucceeded": true
          },
          "sourceIsSelf": true
        }
      ],
      "description": "成功施放器诀双剑合璧或摧灵斩后，下一次震岳或掠霆提高一重。若用九劫归一，震岳和掠霆两种攻击各提高一重。"
    },
    {
      "id": "jiujie.passive.cuiling",
      "name": "摧灵",
      "modifiers": [
        {
          "when": {
            "skillIds": [
              "dao_equipment.skill.cuiling"
            ]
          },
          "damageBonus": 0.42
        }
      ],
      "description": "器诀摧灵斩造成的伤害提高42%。"
    },
    {
      "id": "jiujie.passive.jingting",
      "name": "惊霆",
      "modifiers": [
        {
          "when": {
            "skillIds": [
              "jiujie.skill.strike_1",
              "jiujie.skill.strike_2",
              "jiujie.skill.strike_3",
              "jiujie.skill.sweep_1",
              "jiujie.skill.sweep_2",
              "jiujie.skill.sweep_3",
              "jiujie.skill.tribulation"
            ],
            "requireKind": "physical",
            "targetSlot": "primary",
            "expression": "(fact.jiujie_type == 2) * (fact.jiujie_rank <= 2)"
          },
          "damageBonus": 0.3
        }
      ],
      "description": "掠霆强化后仍为一重或二重时，对主目标的伤害提高30%。"
    },
    {
      "id": "jiujie.passive.physical_pet",
      "name": "电掣",
      "modifiers": [
        {
          "when": {
            "requireKind": "physical",
            "foeKind": "pet"
          },
          "damageBonus": 0.2,
          "defenseIgnoreAdd": 0.1
        }
      ],
      "description": "对灵兽忽略10%物防，造成的物理伤害提高20%。"
    },
    {
      "id": "jiujie.passive.magic_pet",
      "name": "电掣",
      "modifiers": [
        {
          "when": {
            "requireKind": "spell",
            "foeKind": "pet"
          },
          "damageBonus": 0.2,
          "defenseIgnoreAdd": 0.1
        }
      ],
      "description": "对灵兽忽略10%法防，造成的法术伤害提高20%。"
    },
    {
      "id": "jiujie.passive.dianguang",
      "name": "电光",
      "description": "震岳经过其他强化后若为一重或二重，有18%概率再提高一重。九劫归一对主目标的震岳也能触发。"
    },
    {
      "id": "jiujie.passive.leitun",
      "name": "雷吞",
      "description": "武器和衣甲中，每装备一件金、风或雷属性道装，施放引劫入体时额外获得1层劫雷灌注。两件道装的属性可不同。"
    },
    {
      "id": "jiujie.passive.shencai",
      "name": "神采",
      "hooks": [
        {
          "on": "onDeath",
          "effects": [
            {
              "type": "modifyFact",
              "key": "jiujie_kill_sweep",
              "value": 1
            }
          ],
          "when": {
            "skillIds": [
              "jiujie.skill.strike_1",
              "jiujie.skill.strike_2",
              "jiujie.skill.strike_3",
              "jiujie.skill.sweep_1",
              "jiujie.skill.sweep_2",
              "jiujie.skill.sweep_3",
              "jiujie.skill.tribulation"
            ],
            "excludeFoeKinds": [
              "npc"
            ],
            "targetEnemy": true,
            "expression": "(fact.jiujie_type == 2) * (fact.jiujie_rank == 3)"
          },
          "sourceIsSelf": true
        }
      ],
      "description": "强化后恰为三重的掠霆若击倒至少一名敌方修士或灵兽，有25%概率免除这次攻击带来的休息。每次攻击最多判定一次。"
    },
    {
      "id": "jiujie.passive.zhenhun",
      "name": "震魂",
      "hooks": [
        {
          "on": "onDeath",
          "effects": [
            {
              "type": "applyStatus",
              "statusId": "jiujie.status.confuse",
              "duration": 1,
              "targeting": {
                "side": "enemy",
                "mode": "explicit",
                "count": 1,
                "includeDowned": true,
                "includeDead": true
              }
            }
          ],
          "when": {
            "skillIds": [
              "jiujie.skill.strike_1",
              "jiujie.skill.strike_2",
              "jiujie.skill.strike_3",
              "jiujie.skill.sweep_1",
              "jiujie.skill.sweep_2",
              "jiujie.skill.sweep_3",
              "jiujie.skill.tribulation"
            ],
            "excludeFoeKinds": [
              "npc"
            ],
            "targetEnemy": true,
            "expression": "(fact.jiujie_type == 1) * (fact.jiujie_rank == 3)"
          },
          "chance": 0.5,
          "sourceIsSelf": true
        }
      ],
      "description": "强化后恰为三重的震岳击倒敌方修士或灵兽时，有50%概率施加1回合[[jiujie.status.confuse]]。若目标在期限内复起，仍会受其影响。"
    },
    {
      "id": "jiujie.passive.rebirth",
      "name": "劫后逢生",
      "hooks": [
        {
          "on": "onFatal",
          "effects": [
            {
              "type": "restoreHp",
              "power": "maxHp * 0.1",
              "allowFatal": true
            }
          ],
          "when": {
            "requireStatusIds": [
              "jiujie.status.guardian"
            ],
            "oncePerBattle": true
          },
          "targetIsSelf": true,
          "aim": "self"
        }
      ],
      "description": "在[[jiujie.status.guardian]]持续期间受到致命伤害时，气血恢复至最大气血的10%，每场战斗最多触发一次。"
    },
    {
      "id": "jiujie.passive.qishi",
      "name": "气势",
      "description": "每场战斗中，震岳、掠霆第一次以某一重数出手时，各有15%概率免除本次休息。按强化后的重数计算，两个招式分别记录。"
    },
    {
      "id": "jiujie.passive.poyue",
      "name": "破岳",
      "modifiers": [
        {
          "when": {
            "skillIds": [
              "jiujie.skill.strike_1",
              "jiujie.skill.strike_2",
              "jiujie.skill.strike_3",
              "jiujie.skill.sweep_1",
              "jiujie.skill.sweep_2",
              "jiujie.skill.sweep_3",
              "jiujie.skill.tribulation"
            ],
            "requireKind": "physical",
            "expression": "fact.jiujie_type == 1"
          },
          "defenseIgnoreAdd": 0.05
        }
      ],
      "description": "震岳忽略目标5%的物理防御。九劫归一对主目标的震岳也享受此效果。"
    },
    {
      "id": "jiujie.passive.gandian",
      "name": "感电",
      "hooks": [
        {
          "on": "onRoundStart",
          "effects": [
            {
              "type": "randomBranch",
              "branchId": "jiujie.branch.red_mark",
              "chance": "known.jiujie.passive.chiji * if(allyTagCount.sect.jiujie == 1, 0.1, 0)",
              "successEffects": [
                {
                  "type": "removeStatus",
                  "kinds": [
                    "jiujie.status.electric"
                  ],
                  "ownedOnly": true
                },
                {
                  "type": "applyStatus",
                  "statusId": "jiujie.status.red",
                  "duration": 3
                }
              ],
              "failureEffects": [
                {
                  "type": "removeStatus",
                  "kinds": [
                    "jiujie.status.red"
                  ],
                  "ownedOnly": true
                },
                {
                  "type": "applyStatus",
                  "statusId": "jiujie.status.electric",
                  "duration": 3
                }
              ]
            }
          ],
          "when": {
            "sourceStanding": true,
            "expression": "enemyStatus.jiujie.status.electric + enemyStatus.jiujie.status.red < 3"
          },
          "targeting": {
            "side": "enemy",
            "mode": "random",
            "count": 1
          }
        }
      ],
      "description": "回合开始时，若你仍存活，且敌方的雷印和赤雷印合计不足3个，随机给一名可被攻击的敌人施加[[jiujie.status.electric]]。"
    },
    {
