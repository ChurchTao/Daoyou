              "successEffects": [
                {
                  "type": "randomBranch",
                  "branchId": "wuxiang.branch.choice",
                  "chance": "known.wuxiang.passive.wrath.2.1",
                  "successEffects": [
                    {
                      "type": "dispel",
                      "categories": [
                        "buff"
                      ],
                      "maxCount": 1,
                      "random": true
                    }
                  ],
                  "failureEffects": []
                },
                {
