      "description": "本场需要让四种念头组合各显相一次，并等待法相自然消退。四种组合分别是三枚烈念、两枚烈念加一枚寂念、一枚烈念加两枚寂念、三枚寂念。完成后，再用三枚烈念显相时，法相持续时间翻倍。开场自动显相与提前破除的法相不计。"
    },
    {
      "id": "wuxiang.passive.wrath.foundation",
      "name": "魔心修罗",
      "modifiers": [
        {
          "when": {
            "skillIds": [
              "wuxiang.skill.overload"
            ]
          },
          "damageBonus": "0.2 * fact.wuxiang_form"
        },
        {
          "when": {
            "requireKind": "physical",
            "targetOwnedStatus": {
              "kind": "wuxiang.breach"
            },
            "initialTargetOwnedStatus": "wuxiang.breach"
          },
          "damageBonus": "0.3 * (1 + if(fact.wuxiang_a == 3, fact.wuxiang_form, 0)) + known.wuxiang.passive.wrath.6.1 * fact.wuxiang_form * 0.05"
        },
        {
          "when": {
            "skillIds": [
              "wuxiang.skill.overload"
            ]
          },
          "damageBonus": "fact.wuxiang_overload * fact.wuxiang_a * 0.08 * (1 + 0.3 * known.wuxiang.passive.wrath.1.3)"
        }
      ],
