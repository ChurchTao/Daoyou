                {
                  "type": "randomBranch",
                  "branchId": "wuxiang.branch.breach",
                  "chance": "(0.3 + 0.15 * fact.wuxiang_form) * (1 - 0.5 * known.wuxiang.passive.wrath.1.2)",
                  "successEffects": [
                    {
                      "type": "applyStatus",
                      "statusId": "wuxiang.status.breach",
                      "duration": 5
                    }
                  ],
                  "failureEffects": []
                }
              ]
