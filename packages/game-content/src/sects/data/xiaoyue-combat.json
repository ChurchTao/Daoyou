  "skills": [
    {
      "id": "xiaoyue.skill.transform",
      "name": "兽形",
      "school": "xiaoyue",
      "description": "观山林百兽之形，运息化为己用。\n消耗20法力获得[[xiaoyue.status.transform]]，物攻增加《百兽化形》等级，持续四个完整后续回合；狮搏、鹏击、连环击和镇形均须处于兽形。",
      "tags": [
        "support"
      ],
      "targeting": {
        "side": "self"
      },
      "effects": [
        {
          "type": "removeStatus",
          "statusIds": [
            "xiaoyue.status.quick_penalty"
          ],
          "targeting": {
            "side": "self"
          }
        },
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.transform",
          "duration": 4,
          "self": true
        },
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.active_transform_ready",
          "duration": 99,
          "self": true
        }
      ],
      "requirement": "(1-hasStatus.xiaoyue.status.transform)+hasStatus.xiaoyue.status.quick_penalty",
      "costMp": 20
    },
    {
      "id": "xiaoyue.skill.lion_strike",
      "name": "狮搏",
      "school": "xiaoyue",
      "description": "借兽形之势，近身一搏。\n兽形期间消耗30法力，攻击一名敌人，物理伤害系数1.15。",
      "tags": [
        "physical"
      ],
      "targeting": {
        "side": "enemy",
        "count": 1
      },
      "effects": [
        {
          "type": "physicalHit",
          "coeff": 1.15
        }
      ],
      "requirement": "hasStatus.xiaoyue.status.transform",
      "costMp": 30
    },
    {
      "id": "xiaoyue.skill.eagle_strike",
      "name": "鹏击",
      "school": "xiaoyue",
      "description": "振羽凌空，俯冲敌阵。\n兽形期间攻击多名敌人；《生死搏》达到30／50／75／125级时，至多攻击3／4／5／6人。基础消耗30法力，每增加一个实际目标另耗10法力；出手后进入[[xiaoyue.status.rest]]，冷却两回合。",
      "tags": [
        "physical"
      ],
      "targeting": {
        "side": "enemy",
        "mode": "fill",
        "count": "if(skillLevel>=125,6,if(skillLevel>=75,5,if(skillLevel>=50,4,3)))",
        "maxSelected": 1
      },
      "effects": [
        {
          "type": "randomBranch",
          "branchId": "xiaoyue.eagle.roar",
          "chance": 0.3,
          "successEffects": [
            {
              "type": "applyStatus",
              "statusId": "xiaoyue.status.roar_boost",
              "duration": 1,
              "self": true
            }
          ],
          "failureEffects": [],
          "when": {
            "expression": "known.xiaoyue.passive.blood.3.2*hasStatus.xiaoyue.status.active_transform_ready"
          }
        },
        {
          "type": "physicalHit",
          "coeff": 0.85
        },
        {
          "type": "removeStatus",
          "statusIds": [
            "xiaoyue.status.roar_boost",
            "xiaoyue.status.active_transform_ready"
          ],
          "targeting": {
            "side": "self"
          }
        },
        {
          "type": "skipNextAction"
        },
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.rest",
          "duration": 1,
          "self": true
        }
      ],
      "requirement": "hasStatus.xiaoyue.status.transform",
      "costMp": "30+10*(targets-1)",
      "cooldownRounds": 2,
      "recoveryStatusId": "xiaoyue.status.rest"
    },
    {
      "id": "xiaoyue.skill.chain_strike",
      "name": "连环击",
      "school": "xiaoyue",
      "description": "连势不绝，逼敌失守。\n兽形期间连续攻击一名敌人；《狂兽诀》达到30／50／75／125／175级时，出手2／3／5／6／7段。每段预付30法力，目标倒地即停止余段；出手后进入[[xiaoyue.status.rest]]并取消兽形，习得乱击后改为缩短兽形两回合。",
      "tags": [
        "physical"
      ],
      "targeting": {
        "side": "enemy",
        "count": 1
      },
      "effects": [
        {
          "type": "physicalHit",
          "hits": "if(skillLevel>=175,7,if(skillLevel>=125,6,if(skillLevel>=75,5,if(skillLevel>=50,3,2))))",
          "coeff": [
            0.72,
            0.62,
            0.52,
            0.42,
            0.32,
            0.27,
            0.23
          ]
        },
        {
          "type": "skipNextAction"
        },
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.rest",
          "duration": 1,
          "self": true
        },
        {
          "type": "removeStatus",
          "statusIds": [
            "xiaoyue.status.transform"
          ],
          "targeting": {
            "side": "self"
          },
          "when": {
            "expression": "1-known.xiaoyue.passive.blood.6.2"
          }
        },
        {
          "type": "modifyStatusDuration",
          "kinds": [
            "xiaoyue.status.transform"
          ],
          "amount": -2,
          "targeting": {
            "side": "self"
          },
          "when": {
            "expression": "known.xiaoyue.passive.blood.6.2"
          }
        }
      ],
      "requirement": "hasStatus.xiaoyue.status.transform",
      "costMp": "30*if(skillLevel>=175,7,if(skillLevel>=125,6,if(skillLevel>=75,5,if(skillLevel>=50,3,2))))",
      "recoveryStatusId": "xiaoyue.status.rest"
    },
    {
      "id": "xiaoyue.skill.elephant_seal",
      "name": "镇形",
      "school": "xiaoyue",
      "description": "踏地镇形，以攻势封住去路。\n兽形期间消耗50法力攻击一名敌人；物理命中后另作封印判定，命中者下一完整行动窗口受[[xiaoyue.status.stun]]限制。施放后取消兽形，自身下一回合受[[xiaoyue.status.spell_rest]]限制。",
      "tags": [
        "physical",
        "seal"
      ],
      "targeting": {
        "side": "enemy",
        "count": 1
      },
      "effects": [
        {
          "type": "physicalHit",
          "coeff": 0.8
        },
        {
          "type": "randomBranch",
          "branchId": "xiaoyue.elephant.keep_form",
          "chance": "0.7*known.xiaoyue.passive.blood.3.3*(hp/maxHp<0.3)",
