              }
            }
          ],
          "failureEffects": [
            {
              "type": "removeStatus",
              "statusIds": [
                "xiaoyue.status.transform"
              ],
              "targeting": {
                "side": "self"
              }
            }
          ]
        },
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.spell_rest_pending",
          "duration": 1,
          "self": true
        }
