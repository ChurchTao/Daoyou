              "statusIds": [
                "xiaoyue.status.transform"
              ],
              "targeting": {
                "side": "self"
              }
            }
          ]
        },
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.spell_rest_pending",
          "duration": 1,
          "self": true
        }
      ],
      "requirement": "hasStatus.xiaoyue.status.transform",
      "costMp": 50,
      "sealBase": 55,
      "hooks": [
        {
          "on": "afterStrike",
