  "skills": [
    {
      "id": "xiaoyue.skill.transform",
      "name": "兽形",
      "school": "xiaoyue",
      "description": "观山林百兽之形，运息化为己用。\n消耗20法力获得[[xiaoyue.status.transform]]，物攻增加《百兽化形》等级，持续四个完整后续回合；鹏击、连环击和镇形须处于兽形，狮搏每场有一次合并化形的机会。",
      "tags": [
        "support"
      ],
      "targeting": {
        "side": "self"
      },
      "effects": [
        {
          "type": "removeStatus",
          "statusIds": [
            "xiaoyue.status.quick_penalty"
          ],
          "targeting": {
            "side": "self"
          }
        },
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.transform",
          "duration": 4,
          "self": true
        },
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.active_transform_ready",
          "duration": 99,
          "self": true
        }
      ],
      "requirement": "(1-hasStatus.xiaoyue.status.transform)+hasStatus.xiaoyue.status.quick_penalty",
      "costMp": 20
    },
    {
      "id": "xiaoyue.skill.lion_strike",
      "name": "狮搏",
      "school": "xiaoyue",
      "description": "借兽形之势，近身一搏。\n兽形期间消耗30法力，攻击一名敌人，物理伤害系数1.15。已学会兽形时，每场战斗有一次机会在无兽形时施放，合付50法力，先获得完整兽形再攻击；继承宁息、展翅与主动兽形余势。启用灵兽同契时，狮搏命中即可让自己在场且存活的灵兽获得[[xiaoyue.status.lion_soul]]，每回合最多触发一次。",
      "tags": [
        "physical"
      ],
      "targeting": {
        "side": "enemy",
        "count": 1
      },
      "effects": [
        {
          "type": "removeStatus",
          "statusIds": [
            "xiaoyue.status.quick_penalty"
          ],
          "targeting": {
            "side": "self"
          },
          "when": {
            "expression": "1-hasStatus.xiaoyue.status.transform"
          }
        },
        {
          "type": "modifyFact",
          "key": "xiaoyue_opening_transform_used",
          "value": 1,
          "when": {
            "expression": "1-hasStatus.xiaoyue.status.transform"
          }
        },
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.active_transform_ready",
          "duration": 99,
          "self": true,
          "when": {
            "expression": "1-hasStatus.xiaoyue.status.transform"
          }
        },
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.wing_guard_pending",
          "duration": 1,
          "self": true,
          "when": {
            "expression": "(1-hasStatus.xiaoyue.status.transform)*known.xiaoyue.passive.blood.4.2"
          }
        },
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.transform",
          "duration": "4+known.xiaoyue.passive.blood.2.2",
          "self": true,
          "when": {
            "expression": "1-hasStatus.xiaoyue.status.transform"
          }
        },
        {
          "type": "physicalHit",
          "coeff": 1.15
        }
      ],
      "requirement": "hasStatus.xiaoyue.status.transform+(1-hasStatus.xiaoyue.status.transform)*(1-min(1,fact.xiaoyue_opening_transform_used))*known.xiaoyue.skill.transform",
      "costMp": "30+20*(1-hasStatus.xiaoyue.status.transform)"
    },
    {
      "id": "xiaoyue.skill.eagle_strike",
      "name": "鹏击",
      "school": "xiaoyue",
      "description": "振羽凌空，俯冲敌阵。\n兽形期间可攻击多名敌人。《生死搏》达到30／50／75／125级时，最多攻击3／4／5／6名敌人。攻击第一名敌人消耗30法力，每多攻击一名额外消耗10法力。出手后进入[[xiaoyue.status.rest]]，冷却两回合。",
      "tags": [
        "physical"
      ],
      "targeting": {
        "side": "enemy",
        "mode": "fill",
        "count": "if(skillLevel>=125,6,if(skillLevel>=75,5,if(skillLevel>=50,4,3)))",
        "maxSelected": 1
      },
      "effects": [
        {
          "type": "randomBranch",
          "branchId": "xiaoyue.eagle.roar",
          "chance": 0.3,
          "successEffects": [
            {
              "type": "applyStatus",
              "statusId": "xiaoyue.status.roar_boost",
              "duration": 1,
              "self": true
            }
          ],
          "failureEffects": [],
          "when": {
            "expression": "known.xiaoyue.passive.blood.3.2*hasStatus.xiaoyue.status.active_transform_ready"
          }
        },
        {
          "type": "physicalHit",
          "coeff": 0.85
        },
        {
          "type": "removeStatus",
          "statusIds": [
            "xiaoyue.status.roar_boost",
            "xiaoyue.status.active_transform_ready"
          ],
          "targeting": {
            "side": "self"
          }
        },
        {
          "type": "skipNextAction"
        },
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.rest",
          "duration": 1,
          "self": true
        }
      ],
      "requirement": "hasStatus.xiaoyue.status.transform",
      "costMp": "30+10*(targets-1)",
      "cooldownRounds": 2,
      "recoveryStatusId": "xiaoyue.status.rest"
    },
    {
      "id": "xiaoyue.skill.chain_strike",
      "name": "连环击",
      "school": "xiaoyue",
      "description": "连势不绝，逼敌失守。\n兽形期间连续攻击一名敌人。《狂兽诀》达到30／50／75／125／175级时，分别攻击2／3／5／6／7次。出手前按攻击次数一次付清，每次30法力。目标倒地时，剩余攻击停止。出手后进入[[xiaoyue.status.rest]]，保留兽形且不额外缩短其时长，兽形仍按正常回合流逝。",
      "tags": [
        "physical"
      ],
      "targeting": {
        "side": "enemy",
        "count": 1
      },
      "effects": [
        {
          "type": "physicalHit",
          "hits": "if(skillLevel>=175,7,if(skillLevel>=125,6,if(skillLevel>=75,5,if(skillLevel>=50,3,2))))",
          "coeff": [
            0.72,
            0.62,
            0.52,
            0.42,
            0.32,
            0.27,
            0.23
          ]
        },
        {
          "type": "skipNextAction"
        },
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.rest",
          "duration": 1,
          "self": true
        }
      ],
      "requirement": "hasStatus.xiaoyue.status.transform",
      "costMp": "30*if(skillLevel>=175,7,if(skillLevel>=125,6,if(skillLevel>=75,5,if(skillLevel>=50,3,2))))",
      "recoveryStatusId": "xiaoyue.status.rest"
    },
    {
      "id": "xiaoyue.skill.elephant_seal",
      "name": "镇形",
      "school": "xiaoyue",
      "description": "踏地镇形，以攻势封住去路。\n兽形期间消耗50法力攻击一名敌人。物理攻击命中后，有机会封印目标，使其下回合进入[[xiaoyue.status.stun]]。施放后自己下回合进入[[xiaoyue.status.spell_rest]]。通常会结束兽形，经脉「怒象」有机会保留兽形。",
      "tags": [
        "physical",
        "seal"
      ],
      "targeting": {
        "side": "enemy",
        "count": 1
      },
      "effects": [
        {
          "type": "physicalHit",
          "coeff": 0.8
        },
        {
          "type": "randomBranch",
          "branchId": "xiaoyue.elephant.keep_form",
          "chance": "0.7*known.xiaoyue.passive.blood.3.3*(hp/maxHp<0.3)",
          "successEffects": [
            {
              "type": "modifyStatusDuration",
              "kinds": [
                "xiaoyue.status.transform"
              ],
              "amount": 2,
              "targeting": {
                "side": "self"
              }
            }
          ],
          "failureEffects": [
            {
              "type": "removeStatus",
              "statusIds": [
                "xiaoyue.status.transform"
              ],
              "targeting": {
                "side": "self"
              }
            }
          ]
        },
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.spell_rest_pending",
          "duration": 1,
          "self": true
        }
      ],
      "requirement": "hasStatus.xiaoyue.status.transform",
      "costMp": 50,
      "sealBase": 55,
      "hooks": [
        {
          "on": "afterStrike",
          "effects": [
            {
              "type": "applyStatus",
              "statusId": "xiaoyue.status.stun_pending",
              "duration": 1,
              "hit": "seal"
            }
          ],
          "sourceIsSelf": true,
          "aim": "hookTarget",
          "when": {
            "skillIds": [
              "xiaoyue.skill.elephant_seal"
            ],
            "damageOrigins": [
              "action-direct"
            ]
          }
        }
      ]
    },
    {
      "id": "xiaoyue.skill.intimidate",
      "name": "兽威",
      "school": "xiaoyue",
      "description": "观兽之威，令敌暂缓进逼。\n消耗20法力尝试封印一名敌方灵兽或普通生灵。封印成功时，目标下回合进入[[xiaoyue.status.stun]]。玩家角色不能被选为目标，免疫控制的目标不会被封印。",
      "tags": [
        "seal"
      ],
      "targeting": {
        "side": "enemy",
        "count": 1,
        "requireKinds": [
          "pet",
          "npc"
        ]
      },
      "effects": [
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.stun_pending",
          "duration": 1,
          "hit": "seal"
        }
      ],
      "costMp": 20,
      "sealBase": 55
    },
    {
      "id": "xiaoyue.skill.meditate",
      "name": "定心",
      "school": "xiaoyue",
      "description": "收束心神，稳住吐息。\n消耗40法力获得[[xiaoyue.status.calm]]，持续四个后续回合。法攻和法防各提高《百兽化形》等级的30%，舍去小数。",
      "tags": [
        "support"
      ],
      "targeting": {
        "side": "self"
      },
      "effects": [
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.calm",
          "duration": 4,
          "self": true
        }
      ],
      "costMp": 40
    },
    {
      "id": "xiaoyue.skill.frenzy",
      "name": "狂反",
      "school": "xiaoyue",
      "description": "守中蓄势，受击即反扑。\n消耗30法力获得[[xiaoyue.status.frenzy]]，持续三个后续回合；受到敌人的直接物理攻击并损失气血时自动反击，反击物理系数0.5，同一次行动至多反击一次。",
      "tags": [
        "support"
      ],
      "targeting": {
        "side": "self"
      },
      "effects": [
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.frenzy",
          "duration": 3,
          "self": true
        }
      ],
      "costMp": 30
    },
    {
      "id": "xiaoyue.skill.mana_breath",
      "name": "养息",
      "school": "xiaoyue",
      "description": "缓息归元，以气血换取法力。\n支付固定30气血获得[[xiaoyue.status.mana_breath]]，持续三个后续回合；每轮末回复《百兽化形》等级一半的法力，向下取整。",
      "tags": [
        "support"
      ],
      "targeting": {
        "side": "self"
      },
      "effects": [
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.mana_breath",
          "duration": 4,
          "self": true
        }
      ],
      "costHp": 30
    },
    {
      "id": "xiaoyue.skill.demon_unbound",
      "name": "裂甲狂身",
      "school": "xiaoyue",
      "description": "舍护身之势，换迅猛攻势。\n消耗30法力获得[[xiaoyue.status.demon_unbound]]。物防降为施放前的一半，物攻提高施放前物防的10%，持续三个后续回合。倒地后解除，复活的回合无法施放。",
      "tags": [
        "support"
      ],
      "targeting": {
        "side": "self"
      },
      "effects": [
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.demon_unbound",
          "duration": 3,
          "self": true
        }
      ],
      "costMp": 30,
      "forbidRevivedRound": true
    },
    {
      "id": "xiaoyue.skill.best_partners",
      "name": "最佳搭档",
      "school": "xiaoyue",
      "description": "一人一兽各守其步，于同一破绽相应。\n处于兽形且自己的出战灵兽仍在场、存活时才可施放。消耗500法力，用狮搏攻击并施加[[xiaoyue.status.best_partner_mark]]。施放时在场的灵兽在下次行动中用直接物理或法术攻击命中该目标时，对该目标的第一击伤害提高20%。这次狮搏和灵兽接力的物理攻击可绕过护卫代挡。开场冷却四回合，施放后冷却八回合。",
      "tags": [
        "physical"
      ],
      "targeting": {
        "side": "enemy",
        "count": 1
      },
      "effects": [
        {
          "type": "physicalHit",
          "coeff": 1.15
        },
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.best_partner_mark",
          "duration": 1
        }
      ],
      "requirement": "ownStandingPet*hasStatus.xiaoyue.status.transform",
      "costMp": 500,
      "cooldownRounds": 8,
      "initialCooldownRounds": 4,
      "modifiers": [
        {
          "ignoreProtection": true,
          "when": {
            "skillIds": [
              "xiaoyue.skill.best_partners"
            ]
          }
        }
      ]
    },
    {
      "id": "xiaoyue.skill.foundation",
      "name": "兽王本能",
      "school": "xiaoyue",
      "description": "兽形起落之间，留住反扑的本能。\n处于[[xiaoyue.status.mana_breath]]时，每回合结束回复法力。处于[[xiaoyue.status.frenzy]]时，受到敌人的直接物理攻击并损失气血时，会自动反击，同一次行动最多反击一次。兽形结束时，由迅捷或主动化形带来的额外效果一并消失。",
      "tags": [
        "passive"
      ],
      "targeting": {
        "side": "self"
      },
      "effects": [],
      "hooks": [
        {
          "on": "onRoundEnd",
          "effects": [
            {
              "type": "restoreMp",
              "power": "floor(knownSkillLevel.xiaoyue.skill.mana_breath/2)"
            }
          ],
          "aim": "self",
          "when": {
            "requireStatusKinds": [
              "xiaoyue.status.mana_breath"
            ],
            "sourceStanding": true,
            "expression": "statusRounds.xiaoyue.status.mana_breath<4"
          }
        },
        {
          "on": "onBeHit",
          "effects": [
            {
              "type": "physicalHit",
              "coeff": 0.5
            }
          ],
          "targetIsSelf": true,
          "requireKind": "physical",
          "retaliation": true,
          "aim": "hookSource",
          "when": {
            "requireStatusKinds": [
              "xiaoyue.status.frenzy"
            ],
            "damageOrigins": [
              "action-direct"
            ],
            "oncePerActionTarget": true
          },
          "sourceIsEnemy": true
        },
        {
          "on": "onStatusRemoved",
          "targetIsSelf": true,
          "aim": "self",
          "when": {
            "removedStatusKind": "xiaoyue.status.transform"
          },
          "effects": [
            {
              "type": "removeStatus",
              "statusIds": [
                "xiaoyue.status.quick_penalty",
                "xiaoyue.status.active_transform_ready"
              ]
            }
          ]
        }
      ]
    }
