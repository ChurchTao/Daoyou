    {
      "id": "xiaoyue.skill.transform",
      "name": "兽形",
      "school": "xiaoyue",
      "description": "消耗20法力凝成兽形，物攻临时增加主心法等级，持续四个完整后续回合；兽形是狮搏、鹏击、连环击和镇形的前提。",
      "tags": [
        "support"
      ],
      "targeting": {
        "side": "self"
      },
      "effects": [
        {
          "type": "removeStatus",
          "statusIds": [
            "xiaoyue.status.quick_penalty"
          ],
          "targeting": {
            "side": "self"
          }
        },
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.transform",
          "duration": 4,
          "self": true
        },
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.active_transform_ready",
          "duration": 99,
          "self": true
        }
      ],
      "requirement": "(1-hasStatus.xiaoyue.status.transform)+hasStatus.xiaoyue.status.quick_penalty",
      "costMp": 20
    },
    {
      "id": "xiaoyue.skill.lion_strike",
      "name": "狮搏",
      "school": "xiaoyue",
      "description": "兽形期间消耗30法力，对单个敌人发动一次较强物理攻击，首版物理系数1.15。",
      "tags": [
        "physical"
      ],
      "targeting": {
        "side": "enemy",
        "count": 1
      },
      "effects": [
        {
          "type": "physicalHit",
          "coeff": 1.15
        }
      ],
      "requirement": "hasStatus.xiaoyue.status.transform",
      "costMp": 30
    },
    {
      "id": "xiaoyue.skill.eagle_strike",
      "name": "鹏击",
      "school": "xiaoyue",
      "description": "兽形期间攻击多名敌人；随《生死搏》达到30／50／75／125级，至多攻击3／4／5／6人。基础消耗30法力，每增加一个实际目标另耗10法力。出手后下一次人物行动休息，也不能连续两回合使用。",
      "tags": [
        "physical"
      ],
      "targeting": {
        "side": "enemy",
        "mode": "fill",
        "count": "if(skillLevel>=125,6,if(skillLevel>=75,5,if(skillLevel>=50,4,3)))",
        "maxSelected": 1
      },
      "effects": [
        {
          "type": "randomBranch",
          "branchId": "xiaoyue.eagle.roar",
          "chance": 0.3,
          "successEffects": [
            {
              "type": "applyStatus",
              "statusId": "xiaoyue.status.roar_boost",
              "duration": 1,
              "self": true
            }
          ],
          "failureEffects": [],
          "when": {
            "expression": "known.xiaoyue.passive.blood.3.2*hasStatus.xiaoyue.status.active_transform_ready"
          }
        },
        {
          "type": "physicalHit",
          "coeff": 0.85
        },
        {
          "type": "removeStatus",
          "statusIds": [
            "xiaoyue.status.roar_boost",
            "xiaoyue.status.active_transform_ready"
          ],
          "targeting": {
            "side": "self"
          }
        },
        {
          "type": "skipNextAction"
        },
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.rest",
          "duration": 1,
          "self": true
        }
      ],
      "requirement": "hasStatus.xiaoyue.status.transform",
      "costMp": "30+10*(targets-1)",
      "cooldownRounds": 2,
      "recoveryStatusId": "xiaoyue.status.rest"
    },
    {
      "id": "xiaoyue.skill.chain_strike",
      "name": "连环击",
      "school": "xiaoyue",
      "description": "兽形期间连续攻击一名敌人；随《狂兽诀》达到30／50／75／125／175级，出手2／3／5／6／7段。每段预付30法力；目标倒地即停止余段。出手后下一次人物行动休息并取消兽形。",
      "tags": [
        "physical"
      ],
      "targeting": {
        "side": "enemy",
        "count": 1
      },
      "effects": [
        {
          "type": "physicalHit",
          "hits": "if(skillLevel>=175,7,if(skillLevel>=125,6,if(skillLevel>=75,5,if(skillLevel>=50,3,2))))",
          "coeff": [
            0.72,
            0.62,
            0.52,
            0.42,
            0.32,
            0.27,
            0.23
          ]
        },
        {
          "type": "skipNextAction"
        },
        {
          "type": "applyStatus",
          "statusId": "xiaoyue.status.rest",
          "duration": 1,
          "self": true
        },
        {
          "type": "removeStatus",
          "statusIds": [
            "xiaoyue.status.transform"
          ],
          "targeting": {
            "side": "self"
          },
          "when": {
            "expression": "1-known.xiaoyue.passive.blood.6.2"
          }
        },
        {
          "type": "modifyStatusDuration",
          "kinds": [
            "xiaoyue.status.transform"
          ],
          "amount": -2,
          "targeting": {
            "side": "self"
          },
          "when": {
            "expression": "known.xiaoyue.passive.blood.6.2"
          }
        }
      ],
      "requirement": "hasStatus.xiaoyue.status.transform",
      "costMp": "30*if(skillLevel>=175,7,if(skillLevel>=125,6,if(skillLevel>=75,5,if(skillLevel>=50,3,2))))",
      "recoveryStatusId": "xiaoyue.status.rest"
    },
    {
      "id": "xiaoyue.skill.elephant_seal",
      "name": "镇形",
      "school": "xiaoyue",
      "description": "兽形期间消耗50法力攻击单个敌人；物理命中后另作封印判定，使其下一完整行动窗口无法行动。自身下一回合禁用本宗神通并取消兽形。",
      "tags": [
        "physical",
        "seal"
      ],
      "targeting": {
        "side": "enemy",
        "count": 1
      },
