  "paths": [
    {
      "id": "youdu.path.soul_judge",
      "name": "拘魂锁命",
      "description": "用裂魂咒造成固定伤害，以滞魂咒减缓敌人行动。拘灵术可限制敌方人物复活，还魂决可救起倒地的队友。",
      "requiresConnectedNodes": true,
      "foundationPassives": [],
      "nodes": [
        {
          "id": "youdu.node.soul_judge.yanluo",
          "name": "断魂",
          "layer": 1,
          "slot": 1,
          "description": "与生灵交战时，裂魂咒额外造成相当于武器所提供物理攻击15%的伤害。你在场存活时，敌方人物或生灵倒下便获得[[youdu.status.judgment_ready]]，使灭魂杀伤害提高50%。若本次灭魂杀未击倒人物或生灵，则消耗断魂。",
          "passives": [
            "youdu.passive.yanluo"
          ]
        },
        {
          "id": "youdu.node.soul_judge.recoil",
          "name": "护魂",
          "layer": 1,
          "slot": 2,
          "description": "受到的法术伤害（含固定伤害法术）减少65点。",
          "passives": [
            "youdu.passive.recoil"
          ]
        },
        {
          "id": "youdu.node.soul_judge.night_walk",
          "name": "幽行",
          "layer": 1,
          "slot": 3,
          "description": "常驻速度、物理攻击各增加20点，裂魂咒伤害增加25点。",
          "passives": [
            "youdu.passive.night_walk"
          ],
          "panel": [
            {
              "attr": "speed",
              "mode": "add",
              "value": 20
            },
            {
              "attr": "physicalAtk",
              "mode": "add",
              "value": 20
            }
          ]
        },
        {
          "id": "youdu.node.soul_judge.bone",
          "name": "蚀骨",
          "layer": 2,
          "slot": 1,
          "description": "你施加的[[youdu.status.poison]]被驱散时，中毒者额外损失其当前气血的5%，最多为你的人物等级×5。",
          "passives": [
            "youdu.passive.bone"
          ]
        },
        {
          "id": "youdu.node.soul_judge.gather",
          "name": "摄魂入微",
          "layer": 2,
          "slot": 2,
          "description": "摄魂改为施加强化的[[youdu.status.siphon_strong]]。目标造成的伤害降低15%，受到的伤害提高15%。",
          "patches": [
            {
              "skillId": "youdu.skill.siphon",
              "operation": "replaceStatusId",
              "from": "youdu.status.siphon",
              "to": "youdu.status.siphon_strong"
            }
          ]
        },
        {
          "id": "youdu.node.soul_judge.bound_soul",
          "name": "拘魄",
          "layer": 2,
          "slot": 3,
          "description": "摄魂也可选择倒地敌人，并对其施加[[youdu.status.bound_soul]]。目标本场受到的伤害提高3%，反复施加不会叠加。",
          "passives": [
            "youdu.passive.bound_soul"
          ],
          "patches": [
            {
              "skillId": "youdu.skill.siphon",
              "operation": "includeDownedTargets",
              "value": true
            }
          ]
        },
        {
          "id": "youdu.node.soul_judge.soul_seek",
          "name": "索魂",
          "layer": 3,
          "slot": 1,
          "description": "战斗每进行一回合，拘灵术的命中率+0.5%，累计最多+12%。",
          "passives": [
            "youdu.passive.soul_seek"
          ]
        },
        {
          "id": "youdu.node.soul_judge.soul_wound",
          "name": "乘虚",
          "layer": 3,
          "slot": 2,
          "description": "对带有[[youdu.status.poison]]或灵兽所施毒的目标，拘灵术的命中率+20%。若目标带有魂毒，命中率再+4%。",
          "passives": [
            "youdu.passive.soul_wound"
          ]
        },
        {
          "id": "youdu.node.soul_judge.counter",
          "name": "镇魄",
          "layer": 3,
          "slot": 3,
