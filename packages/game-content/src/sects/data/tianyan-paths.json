    {
      "id": "tianyan.passive.edge",
      "name": "锋芒",
      "description": "天锋一线的直接伤害提高10%，对护盾的额外伤害由50%降至25%。",
      "modifiers": [
        {
          "damageBonus": 0.1,
          "when": {
            "skillIds": [
              "tianyan.skill.metal"
