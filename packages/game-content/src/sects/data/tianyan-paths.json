    },
    {
      "id": "tianyan.passive.roots",
      "name": "盘根",
      "description": "森罗缚减速提高至25%。"
    },
    {
      "id": "tianyan.passive.mountain",
      "name": "镇岳",
      "description": "山河倾覆施加[[tianyan.status.weaken_deep]]，使目标下一次行动造成的物理或法术伤害降低25%，该技能法力消耗提高20%。同时选择「镇世」时，削弱为40%，山河倾覆的法力消耗改为降低10%。"
    },
    {
      "id": "tianyan.passive.prune",
      "name": "斩蔓",
      "description": "持有木行法印时施放天锋一线，触发「断枝」，可再移除目标一个可驱散的增益。"
    },
    {
      "id": "tianyan.passive.corrode",
      "name": "蚀基",
      "description": "持有土行法印时施放森罗缚，附加的[[tianyan.status.foundation_break]]使目标的法术防御降低25%，持续2回合。"
    },
    {
      "id": "tianyan.passive.blunt",
      "name": "钝兵",
