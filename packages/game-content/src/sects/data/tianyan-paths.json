    {
      "id": "tianyan.passive.yan_root",
      "name": "衍法",
      "description": "五行法术触发相生或相克时，直接伤害提高12%。",
      "modifiers": [
        {
          "damageBonus": "0.12*(hasStatus.tianyan.status.mark.water+hasStatus.tianyan.status.mark.earth)",
          "when": {
            "skillIds": [
              "tianyan.skill.wood"
            ],
            "damageOrigins": [
              "action-direct"
            ]
          }
        },
        {
          "damageBonus": "0.12*(hasStatus.tianyan.status.mark.wood+hasStatus.tianyan.status.mark.metal)",
          "when": {
            "skillIds": [
              "tianyan.skill.fire"
            ],
            "damageOrigins": [
              "action-direct"
            ]
          }
        },
        {
          "damageBonus": "0.12*(hasStatus.tianyan.status.mark.fire+hasStatus.tianyan.status.mark.water)",
          "when": {
            "skillIds": [
              "tianyan.skill.earth"
            ],
            "damageOrigins": [
              "action-direct"
            ]
          }
        },
        {
          "damageBonus": "0.12*(hasStatus.tianyan.status.mark.earth+hasStatus.tianyan.status.mark.wood)",
          "when": {
            "skillIds": [
              "tianyan.skill.metal"
            ],
            "damageOrigins": [
              "action-direct"
            ]
          }
        },
        {
          "damageBonus": "0.12*(hasStatus.tianyan.status.mark.metal+hasStatus.tianyan.status.mark.fire)",
          "when": {
            "skillIds": [
              "tianyan.skill.water"
            ],
            "damageOrigins": [
              "action-direct"
            ]
          }
        }
      ]
    },
    {
