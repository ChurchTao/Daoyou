    {
      "id": "tianyan.passive.ember",
      "name": "余火",
      "description": "持有木行法印时施放焚天流火，触发「燎原」，并给本次攻击中主目标以外的前两名敌人附加[[tianyan.status.ember]]。每回合末结算一次，共2次。选择「燎野」后最多可附加给三名额外目标。"
    },
    {
      "id": "tianyan.passive.split",
      "name": "分锋",
      "description": "持有土行法印时施放天锋一线，触发「淬锋」，可额外攻击一名敌人。"
    },
    {
      "id": "tianyan.passive.rain",
      "name": "润物",
      "description": "持有金行法印施放沧海横流可触发「凝露」，持有水行法印施放森罗缚可触发[[tianyan.status.regrowth]]。\n优先选气血比例最低、仍能恢复气血的两名友方，每人恢复量降低30%。仅有一名伤员时，按原本的单人恢复量治疗。无人受伤时，滋荣仍可先施加给最多两名友方，之后每次按降低30%的恢复量治疗。"
    },
    {
      "id": "tianyan.passive.borrow",
      "name": "借势",
      "description": "领悟「借势」。持有法印时可用，对一名敌人造成法术伤害，自己获得持续2回合的护盾，并按「木 → 火 → 土 → 金 → 水 → 木」换成下一种法印。消耗40法力，冷却3回合。"
    },
    {
      "id": "tianyan.passive.plain",
      "name": "守拙",
      "description": "玄元守一减伤提高至30%，持续降至1回合，冷却降至4回合。"
    },
    {
      "id": "tianyan.passive.clear",
      "name": "澄明",
      "description": "澄灵诀可额外移除一个可驱散的持续伤害或普通减益，法力消耗提高50%。"
    },
    {
      "id": "tianyan.passive.wild",
      "name": "燎野",
      "description": "持有木行法印时施放焚天流火，触发「燎原」，最多可攻击五名敌人。第四、第五个攻击目标每少一个，本次法术的直接伤害提高15%，最多提高30%。若已选择「余火」，最多可为三名主目标以外的敌人附加余火。"
    },
    {
      "id": "tianyan.passive.dew",
      "name": "温泽",
      "description": "持有金行法印时施放沧海横流，触发「凝露」，治疗量提高35%。"
    },
    {
      "id": "tianyan.passive.spring",
      "name": "长春",
      "description": "持有水行法印时施放森罗缚，触发[[tianyan.status.regrowth]]。恢复次数由2次增至3次，每次恢复量降低20%。"
    },
    {
      "id": "tianyan.passive.solitary",
      "name": "独照",
      "description": "场上存活敌人不足三人时，每少一人，焚天流火、沧海横流伤害提高6%。",
      "modifiers": [
        {
          "damageBonus": "max(0,3-enemyCount)*0.06",
          "when": {
            "skillIds": [
              "tianyan.skill.fire",
              "tianyan.skill.water"
            ],
            "damageOrigins": [
              "action-direct"
            ]
          }
        }
      ]
    },
    {
      "id": "tianyan.passive.reflection",
      "name": "映霞",
      "description": "自身气血低于40%时，受到的物理伤害和法术伤害降低8%。",
      "modifiers": [
        {
          "damageTakenBonus": -0.08,
          "when": {
            "sourceHpRatioBelow": 0.4,
            "requireKind": "physical"
          }
        },
        {
          "damageTakenBonus": -0.08,
          "when": {
            "sourceHpRatioBelow": 0.4,
            "requireKind": "spell"
          }
        }
      ]
    },
    {
      "id": "tianyan.passive.springwater",
      "name": "清泉",
      "description": "澄灵诀为所选友方恢复少量气血，法力消耗提高20%。"
    },
    {
      "id": "tianyan.passive.return",
      "name": "归流",
      "description": "当前法印与施放的五行法术触发相生或相克时，该次法术的法力消耗降低25%。"
    },
    {
      "id": "tianyan.passive.breath",
      "name": "生息",
      "description": "当前法印与施放的五行法术触发相生时，自身恢复10点法力，每次施法恢复一次。"
    },
    {
      "id": "tianyan.passive.adapt",
      "name": "御变",
