    },
    {
      "id": "tianyan.passive.mirror",
      "name": "明镜",
      "description": "澄灵诀可额外移除一个可驱散的持续伤害或普通减益，法力消耗提高50%。"
    },
    {
      "id": "tianyan.passive.breach",
