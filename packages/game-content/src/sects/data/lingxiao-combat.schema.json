            "kind": {
              "$ref": "#/$defs/__schema6"
            },
            "name": {
              "$ref": "#/$defs/__schema4"
            },
            "power": {
              "$ref": "#/$defs/__schema7"
            },
            "duration": {
              "$ref": "#/$defs/__schema7"
            },
            "when": {
              "$ref": "#/$defs/__schema3"
            }
          },
          "required": [
            "type",
            "id",
            "kind",
            "name",
            "power",
            "duration"
          ],
          "additionalProperties": false
