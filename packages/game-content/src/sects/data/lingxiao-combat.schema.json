            "random",
            "randomAttackTarget",
            "randomNormalAttackTarget",
            "storedAttack"
          ]
        },
        "attrMods": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "hp",
              "maxHp",
              "mp",
              "maxMp",
              "physicalAtk",
              "physicalDef",
              "magicAtk",
              "magicDef",
              "healPower",
              "speed",
              "hit",
              "dodge",
              "critRate",
              "spellCritRate",
              "physicalFuryRate",
              "sealHit",
              "sealResist",
              "attackCultivate",
              "defenseCultivate",
              "spellCultivate",
              "resistSpellCultivate"
