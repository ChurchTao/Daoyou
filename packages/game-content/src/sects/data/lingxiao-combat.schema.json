        "dispellable": {
          "type": "boolean"
        },
        "extendable": {
          "type": "boolean"
        },
        "expireSameRound": {
          "type": "boolean"
        },
        "onExpire": {
          "type": "object",
          "properties": {
            "statusId": {
              "$ref": "#/$defs/__schema0"
