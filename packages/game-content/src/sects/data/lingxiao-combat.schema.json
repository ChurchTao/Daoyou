        "name": {
          "$ref": "#/$defs/__schema2"
        },
        "kind": {
          "$ref": "#/$defs/__schema0"
        },
        "category": {
          "type": "string",
          "enum": [
            "buff",
            "debuff",
            "control",
            "dot"
          ]
        },
        "sourceBound": {
          "type": "boolean"
        },
        "damageTakenFromSource": {
          "$ref": "#/$defs/__schema9"
        },
        "healTaken": {
          "$ref": "#/$defs/__schema9"
        },
        "damageTakenSpell": {
          "$ref": "#/$defs/__schema9"
        },
        "damageDealtPhysical": {
          "$ref": "#/$defs/__schema9"
        },
        "untilBattleEnd": {
          "type": "boolean"
        },
        "priority": {
          "$ref": "#/$defs/__schema9"
        },
        "blocksAction": {
          "type": "boolean"
        },
        "actFirst": {
          "type": "boolean"
