            "duration": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99,
              "$ref": "#/$defs/__schema9"
            }
          },
          "required": [
            "statusId",
            "duration"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "category"
      ],
      "additionalProperties": false
    },
    "__schema13": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "name": {
          "$ref": "#/$defs/__schema2"
        },
        "current": {
          "type": "integer",
          "$ref": "#/$defs/__schema9"
        },
        "max": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 1000000,
              "$ref": "#/$defs/__schema9"
