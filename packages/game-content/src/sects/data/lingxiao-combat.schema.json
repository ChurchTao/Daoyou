      ]
    },
    "__schema11": {
      "type": "string",
      "enum": [
        "physical",
        "spell",
        "seal",
        "support",
        "passive",
        "art"
      ]
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
