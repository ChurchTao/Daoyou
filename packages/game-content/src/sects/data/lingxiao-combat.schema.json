            "when": {
              "$ref": "#/$defs/__schema3"
            }
          },
          "required": [
            "type",
            "statusIds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "dispel"
            },
            "categories": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "buff",
                  "debuff",
                  "control",
                  "dot"
                ]
              }
            },
            "maxCount": {
              "$ref": "#/$defs/__schema7"
            },
            "random": {
              "type": "boolean"
            },
            "when": {
              "$ref": "#/$defs/__schema3"
            }
          },
          "required": [
            "type",
            "categories"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema9": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000
    },
    "__schema10": {
      "anyOf": [
