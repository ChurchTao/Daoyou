            "skillIds": [
              "wanqiao.skill.pierce"
            ]
          }
        }
      ]
    },
    {
      "id": "wanqiao.passive.resonance.bingzhui",
      "name": "截流",
      "description": "持有窍息时对敌方灵兽施放截声，会消耗一层窍息。截声伤害提高35%，驱散目标一个增益，使其下回合无法行动的基础概率从20%提高到60%。",
      "modifiers": [
        {
          "damageBonus": "0.35*(fact.wanqiao_spent>0)",
          "when": {
            "skillIds": [
              "wanqiao.skill.silence"
            ],
            "foeKind": "pet"
          }
        }
      ]
    },
    {
      "id": "wanqiao.passive.resonance.cangai",
      "name": "透隙",
      "description": "持有窍息时对敌方角色施放叩隙，会消耗一层窍息。这次施法伤害提高10%，追加复响攻击的概率翻倍，并额外造成相当于目标实际损失气血50%的伤势。",
      "modifiers": [
        {
          "damageBonus": "0.1*(fact.wanqiao_spent>0)",
          "when": {
            "skillIds": [
              "wanqiao.skill.fissure"
            ],
            "foeKind": "player"
          }
        }
      ],
      "hooks": [
        {
          "on": "afterStrike",
          "effects": [
            {
              "type": "wound",
              "power": "hpDamage*0.5"
            }
          ],
          "sourceIsSelf": true,
          "aim": "hookTarget",
          "when": {
            "skillIds": [
              "wanqiao.skill.fissure"
            ],
            "foeKind": "player",
            "expression": "(fact.wanqiao_spent>0)*(fact.wanqiao_echo==0)"
          }
        }
      ]
    },
    {
      "id": "wanqiao.passive.resonance.shenmu",
      "name": "中虚",
      "description": "武器和衣甲每有一件带木元素，法术伤害提高4%，最多提高8%。",
      "modifiers": [
        {
          "damageBonus": "0.04*fact.woodEquipmentCount",
