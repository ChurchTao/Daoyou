        {
          "id": "wanqiao.node.resonance.fashen",
          "name": "凝听",
          "description": "持有的窍息每多一层，法术暴击率就提高2个百分点。选择凝听后，第2、4、6等偶数回合结束时不再自动恢复窍息。",
          "layer": 1,
          "slot": 1,
          "passives": [
            "wanqiao.passive.resonance.fashen"
          ]
        },
        {
          "id": "wanqiao.node.resonance.fenghun",
          "name": "回护",
          "description": "施放万窍山神通消耗窍息后获得护盾。每消耗一层，护盾值增加相当于人物战斗等级两倍的数值。",
          "layer": 1,
          "slot": 2,
          "passives": [
            "wanqiao.passive.resonance.fenghun"
          ]
        },
        {
          "id": "wanqiao.node.resonance.lingyou",
          "name": "含和",
          "description": "持有窍息时，承受的所有伤害降低2%。",
          "layer": 1,
          "slot": 3,
          "passives": [
            "wanqiao.passive.resonance.lingyou"
          ]
        },
        {
          "id": "wanqiao.node.resonance.zhuiji",
          "name": "再应",
          "description": "众窍鸣追加复响攻击时，若还持有窍息，消耗一层窍息，使这次追加攻击的伤害提高40%。",
          "layer": 2,
          "slot": 1,
          "passives": [
            "wanqiao.passive.resonance.zhuiji"
          ]
        },
        {
          "id": "wanqiao.node.resonance.zhoufa",
