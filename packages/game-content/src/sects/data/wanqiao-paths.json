  "passives": [
    {
      "id": "wanqiao.passive.resonance.fashen",
      "name": "凝听",
      "description": "持有的窍息每多一层，法术暴击率就提高2个百分点。选择凝听后，第2、4、6等偶数回合结束时不再自动恢复窍息。",
      "modifiers": [
        {
          "critChanceAdd": "0.02*resource.wanqiao.resource.breath",
          "when": {
            "requireKind": "spell"
          }
        }
      ]
    },
    {
      "id": "wanqiao.passive.resonance.fenghun",
      "name": "回护",
      "description": "施放万窍山神通消耗窍息后获得护盾。每消耗一层，护盾值增加相当于人物战斗等级两倍的数值。",
      "hooks": [
        {
          "on": "afterAction",
          "effects": [
            {
              "type": "applyBarrier",
              "id": "wanqiao.barrier.breath",
              "kind": "wanqiao.breath",
              "name": "回护",
              "power": "fact.wanqiao_total_spent*level*2",
              "duration": 1
            }
          ],
          "sourceIsSelf": true,
          "aim": "self",
          "when": {
            "skillIds": [
              "wanqiao.skill.chorus",
              "wanqiao.skill.pierce",
              "wanqiao.skill.fissure",
              "wanqiao.skill.silence",
              "wanqiao.skill.echo",
              "wanqiao.skill.blood",
              "wanqiao.skill.rest",
              "wanqiao.skill.hollow",
              "wanqiao.skill.harmony",
              "wanqiao.skill.undertone",
              "wanqiao.skill.catalyze",
              "wanqiao.skill.distill",
              "wanqiao.skill.resonate",
              "wanqiao.skill.coda"
            ],
            "expression": "fact.wanqiao_total_spent>0",
            "sourceStanding": true
          }
        }
      ]
    },
    {
      "id": "wanqiao.passive.resonance.lingyou",
      "name": "含和",
      "description": "持有窍息时，承受的所有伤害降低2%。",
      "modifiers": [
        {
          "allDamageTakenBonus": -0.02,
          "when": {
            "sourceResource": {
              "id": "wanqiao.resource.breath",
              "min": 1
            }
          }
        }
      ]
    },
    {
      "id": "wanqiao.passive.resonance.zhuiji",
      "name": "再应",
      "description": "众窍鸣追加复响攻击时，若还持有窍息，消耗一层窍息，使这次追加攻击的伤害提高40%。",
      "modifiers": [
        {
          "damageResultFactor": 1.4,
          "when": {
            "skillIds": [
              "wanqiao.skill.chorus"
            ],
            "expression": "fact.wanqiao_echo*fact.wanqiao_extra_spent"
          }
        }
      ]
    },
    {
      "id": "wanqiao.passive.resonance.zhoufa",
      "name": "通微",
      "description": "《弦外音》等级达到或超过人物战斗等级时，本场战斗法攻提高60点。",
      "hooks": [
        {
          "on": "onRoundStart",
          "effects": [
            {
              "type": "applyStatus",
              "statusId": "wanqiao.status.incantation",
              "duration": 99,
              "self": true
            }
          ],
          "aim": "self",
          "when": {
            "oncePerBattle": true,
            "expression": "knownSkillLevel.wanqiao.passive.resonance.zhoufa>=level",
            "sourceStanding": true
          }
        }
      ]
    },
    {
      "id": "wanqiao.passive.resonance.kuangye",
      "name": "空鸣",
      "description": "没有窍息时施放众窍鸣，这次施法及其追加的复响攻击以额外100点法攻计算伤害。",
      "modifiers": [
        {
          "damageBonus": 0
        }
      ]
    },
    {
      "id": "wanqiao.passive.resonance.jingcao",
