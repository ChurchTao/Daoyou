      "hooks": [
        {
          "on": "afterStrike",
          "effects": [
            {
              "type": "wound",
              "power": "hpDamage*0.5"
            }
          ],
          "sourceIsSelf": true,
          "aim": "hookTarget",
          "when": {
            "skillIds": [
              "wanqiao.skill.fissure"
            ],
            "foeKind": "player",
            "expression": "(fact.wanqiao_spent>0)*(fact.wanqiao_echo==0)"
