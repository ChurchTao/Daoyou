{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "number",
      "const": 2
    },
    "contentRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "blessings": {
      "minItems": 12,
      "maxItems": 12,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "choices": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "afterFloors": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema3"
          }
        }
      },
      "required": [
        "count",
        "afterFloors"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "formatVersion",
    "contentRevision",
    "blessings",
    "choices"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "might",
            "spell",
            "edge",
            "crit",
            "iron",
            "vigor",
            "shell",
            "haste",
            "mend",
            "beast",
            "beastHaste",
            "beastHide"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "maxStacks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "effect": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "attributes"
                },
                "target": {
                  "type": "string",
                  "enum": [
                    "player",
                    "beasts"
                  ]
                },
                "attributes": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema1"
                  }
                },
                "perStack": {
                  "$ref": "#/$defs/__schema2"
                }
              },
              "required": [
                "kind",
                "target",
                "attributes",
                "perStack"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "crit"
                },
                "target": {
                  "type": "string",
                  "enum": [
                    "player",
                    "beasts"
                  ]
                },
                "perStack": {
                  "$ref": "#/$defs/__schema2"
                }
              },
              "required": [
                "kind",
                "target",
                "perStack"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "damageDealt"
                },
                "target": {
                  "type": "string",
                  "enum": [
                    "player",
                    "beasts"
                  ]
                },
                "perStack": {
                  "$ref": "#/$defs/__schema2"
                }
              },
              "required": [
                "kind",
                "target",
                "perStack"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "damageTaken"
                },
                "target": {
                  "type": "string",
                  "enum": [
                    "player",
                    "beasts"
                  ]
                },
                "perStack": {
                  "$ref": "#/$defs/__schema2"
                }
              },
              "required": [
                "kind",
                "target",
                "perStack"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "icon",
        "label",
        "description",
        "maxStacks",
        "effect"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "string",
      "enum": [
        "physicalAtk",
        "magicAtk",
        "physicalDef",
        "magicDef",
        "speed",
        "maxHp",
        "healPower"
      ]
    },
    "__schema2": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 0.5
    },
    "__schema3": {
      "type": "integer",
      "minimum": 0,
      "maximum": 19
    }
  }
}
