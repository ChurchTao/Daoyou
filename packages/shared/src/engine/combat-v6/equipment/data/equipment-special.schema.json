{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "contentRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "essences": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^dao_equipment\\.essence\\.[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "allowedSlots": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "weapon",
                "head",
                "armor",
                "necklace",
                "belt",
                "footwear"
              ]
            }
          },
          "stackPolicy": {
            "type": "string",
            "enum": [
              "stack",
              "unique",
              "highest"
            ]
          },
          "conflictGroup": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "panelAdd"
                  },
                  "attribute": {
                    "type": "string",
                    "enum": [
                      "physicalAtk",
                      "physicalDef",
                      "magicAtk",
                      "magicDef",
                      "maxHp",
                      "maxMp",
                      "healPower",
                      "speed",
                      "hit",
                      "dodge",
                      "critRate",
                      "spellCritRate",
                      "physicalFuryRate",
                      "sealHit",
                      "sealResist"
                    ]
                  },
                  "value": {
                    "type": "number",
                    "minimum": -1000000,
                    "maximum": 1000000
                  }
                },
                "required": [
                  "type",
                  "attribute",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "requiredStageOffset"
                  },
                  "value": {
                    "type": "integer",
                    "minimum": -1,
                    "maximum": 0
                  }
                },
                "required": [
                  "type",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "rageGain"
                  },
                  "factor": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 100,
                    "multipleOf": 0.000001
                  }
                },
                "required": [
                  "type",
                  "factor"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "rageCost"
                  },
                  "factor": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1,
                    "multipleOf": 0.000001
                  }
                },
                "required": [
                  "type",
                  "factor"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "sealChance"
                  },
                  "side": {
                    "type": "string",
                    "enum": [
                      "hit",
                      "resist"
                    ]
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "multipleOf": 0.000001
                  }
                },
                "required": [
                  "type",
                  "side",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "antiCrit"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "physical",
                      "spell"
                    ]
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "multipleOf": 0.000001
                  }
                },
                "required": [
                  "type",
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "defenseIgnore"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "physical",
                      "spell"
                    ]
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "multipleOf": 0.000001
                  }
                },
                "required": [
                  "type",
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "mpWaiver"
                  },
                  "chance": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "multipleOf": 0.000001
                  }
                },
                "required": [
                  "type",
                  "chance"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "regeneration"
                  },
                  "levelRatio": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "multipleOf": 0.000001
                  }
                },
                "required": [
                  "type",
                  "levelRatio"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "revival"
                  },
                  "chance": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "multipleOf": 0.000001
                  },
                  "hpRatio": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1,
                    "multipleOf": 0.000001
                  }
                },
                "required": [
                  "type",
                  "chance",
                  "hpRatio"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "stackPolicy",
          "effect"
        ],
        "additionalProperties": false
      }
    },
    "arts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^dao_equipment\\.art\\.[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "allowedSlots": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "weapon",
                "head",
                "armor",
                "necklace",
                "belt",
                "footwear"
              ]
            }
          },
          "skillId": {
            "type": "string",
            "pattern": "^dao_equipment\\.skill\\.[a-z][a-z0-9_]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "enum": [
              "self",
              "ally",
              "allies",
              "enemy",
              "enemies"
            ]
          },
          "rageCost": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "effect": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "heal"
                  },
                  "ratio": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "multipleOf": 0.000001
                  },
                  "capPerLevel": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000,
                    "multipleOf": 0.000001
                  }
                },
                "required": [
                  "type",
                  "ratio"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "revive"
                  },
                  "hpRatio": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1,
                    "multipleOf": 0.000001
                  },
                  "capPerLevel": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000,
                    "multipleOf": 0.000001
                  }
                },
                "required": [
                  "type",
                  "hpRatio"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "cleanse"
                  },
                  "kinds": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "healRatio": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "multipleOf": 0.000001
                  }
                },
                "required": [
                  "type",
                  "kinds",
                  "healRatio"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "rageDamage"
                  },
                  "amount": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000,
                    "multipleOf": 0.000001
                  }
                },
                "required": [
                  "type",
                  "amount"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "status"
                  },
                  "statusId": {
                    "type": "string",
                    "pattern": "^dao_equipment\\.status\\.[a-z][a-z0-9_]*$"
                  },
                  "group": {
                    "type": "string",
                    "minLength": 1
                  },
                  "modifier": {
                    "type": "string",
                    "enum": [
                      "physicalDealt",
                      "spellDealt",
                      "physicalTaken",
                      "spellTaken",
                      "speed",
                      "healTaken"
                    ]
                  },
                  "ratio": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1,
                    "multipleOf": 0.000001
                  },
                  "duration": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "battle"
                      },
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 99
                      }
                    ]
                  }
                },
                "required": [
                  "type",
                  "statusId",
                  "group",
                  "modifier",
                  "ratio",
                  "duration"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "restoreMp"
                  },
                  "ratio": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "multipleOf": 0.000001
                  },
                  "casterLevelFactor": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000,
                    "multipleOf": 0.000001
                  },
                  "capPerLevel": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000,
                    "multipleOf": 0.000001
                  }
                },
                "required": [
                  "type",
                  "ratio",
                  "casterLevelFactor"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "massRevive"
                  },
                  "hpRatio": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1,
                    "multipleOf": 0.000001
                  },
                  "remainingHpRatio": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1,
                    "multipleOf": 0.000001
                  },
                  "remainingMpRatio": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "multipleOf": 0.000001
                  }
                },
                "required": [
                  "type",
                  "hpRatio",
                  "remainingHpRatio",
                  "remainingMpRatio"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "dispelBuff"
                  },
                  "chance": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "multipleOf": 0.000001
                  },
                  "artChance": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "multipleOf": 0.000001
                  }
                },
                "required": [
                  "type",
                  "chance",
                  "artChance"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "attack"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "physical",
                      "spell"
                    ]
                  },
                  "resultFactors": {
                    "minItems": 1,
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1,
                      "multipleOf": 0.000001
                    }
                  },
                  "defenseIgnore": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "multipleOf": 0.000001
                  },
                  "mpDamageRatio": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000,
                    "multipleOf": 0.000001
                  }
                },
                "required": [
                  "type",
                  "kind",
                  "resultFactors"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "skillId",
          "description",
          "target",
          "rageCost",
          "effect"
        ],
        "additionalProperties": false
      }
    },
    "rageResource": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "initial": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maximum": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "multipleOf": 0.000001
        }
      },
      "required": [
        "name",
        "initial",
        "maximum"
      ],
      "additionalProperties": false
    },
    "rageGain": {
      "type": "object",
      "properties": {
        "damagePercentScale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "multipleOf": 0.000001
        }
      },
      "required": [
        "damagePercentScale"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "formatVersion",
    "contentRevision",
    "essences",
    "arts",
    "rageResource",
    "rageGain"
  ],
  "additionalProperties": false
}
