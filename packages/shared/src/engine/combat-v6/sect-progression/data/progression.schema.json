{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "contentRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "method": {
      "type": "object",
      "properties": {
        "maxLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "characterLevelAllowance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 180
        },
        "expBase": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "expGrowth": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "multipleOf": 0.000001
        },
        "expRounding": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 100000000
        },
        "stonesPerExp": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.000001
        },
        "stonesRounding": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 100000000
        },
        "insight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        }
      },
      "required": [
        "maxLevel",
        "characterLevelAllowance",
        "expBase",
        "expGrowth",
        "expRounding",
        "stonesPerExp",
        "stonesRounding",
        "insight"
      ],
      "additionalProperties": false
    },
    "meridian": {
      "type": "object",
      "properties": {
        "characterLevels": {
          "minItems": 7,
          "maxItems": 7,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 180
          }
        },
        "expBase": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "expGrowth": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "multipleOf": 0.000001
        },
        "growthExponentCap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "stonesPerExp": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.000001
        },
        "insight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        }
      },
      "required": [
        "characterLevels",
        "expBase",
        "expGrowth",
        "growthExponentCap",
        "stonesPerExp",
        "insight"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "formatVersion",
    "contentRevision",
    "method",
    "meridian"
  ],
  "additionalProperties": false
}
