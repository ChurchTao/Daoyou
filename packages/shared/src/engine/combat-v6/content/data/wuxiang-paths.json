          "sourceIsSelf": true
        },
        {
          "on": "onHealCalc",
          "effects": [
            {
              "type": "modifyHeal",
              "factor": 1.5
            }
          ],
          "when": {
            "skillIds": [
              "wuxiang.skill.nectar",
              "wuxiang.skill.ward",
              "wuxiang.skill.empower",
              "wuxiang.skill.renew"
            ],
            "targetOwnedStatus": {
              "kind": "wuxiang.vow"
            },
            "targetSlot": "normal",
            "damageOrigins": [
              "action-direct"
            ]
