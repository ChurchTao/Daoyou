{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "number",
      "const": 2
    },
    "contentRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "regions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "encounter": {
      "type": "object",
      "properties": {
        "minCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "maxCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "cubChance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "allocationSpread": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        }
      },
      "required": [
        "minCount",
        "maxCount",
        "cubChance",
        "allocationSpread"
      ],
      "additionalProperties": false
    },
    "activity": {
      "type": "object",
      "properties": {
        "explorationCooldownMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      },
      "required": [
        "explorationCooldownMs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "formatVersion",
    "contentRevision",
    "regions",
    "encounter",
    "activity"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/__schema1"
        },
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "name": {
          "$ref": "#/$defs/__schema1"
        },
        "description": {
          "$ref": "#/$defs/__schema1"
        },
        "searchText": {
          "$ref": "#/$defs/__schema1"
        },
        "realmRequirement": {
          "type": "string",
          "enum": [
            "炼气",
            "筑基",
            "金丹",
            "元婴",
            "化神",
            "炼虚",
            "合体",
            "大乘",
            "渡劫"
          ]
        },
        "minLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "maxLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "speciesIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        }
      },
      "required": [
        "nodeId",
        "id",
        "name",
        "description",
        "searchText",
        "realmRequirement",
        "minLevel",
        "maxLevel",
        "speciesIds"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
