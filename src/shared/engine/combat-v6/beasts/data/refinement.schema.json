{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "contentRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "resetLevel": {
      "type": "number",
      "const": 0
    },
    "resetExperience": {
      "type": "number",
      "const": 0
    },
    "restoreLifespan": {
      "type": "boolean"
    },
    "items": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^beast\\.refinement\\.[a-z-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "icon": {
            "type": "string",
            "const": "origin-dew"
          },
          "color": {
            "type": "string",
            "enum": [
              "jade",
              "gold"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "allowedRealms": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "炼气",
                "筑基",
                "金丹",
                "元婴",
                "化神",
                "炼虚",
                "合体",
                "大乘",
                "渡劫"
              ]
            }
          },
          "consumeQuantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "stackLimit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        },
        "required": [
          "id",
          "name",
          "icon",
          "color",
          "description",
          "allowedRealms",
          "consumeQuantity",
          "stackLimit"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "formatVersion",
    "contentRevision",
    "resetLevel",
    "resetExperience",
    "restoreLifespan",
    "items"
  ],
  "additionalProperties": false
}
