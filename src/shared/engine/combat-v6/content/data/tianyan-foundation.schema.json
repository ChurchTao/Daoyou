{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "contentRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "elements": {
      "minItems": 5,
      "maxItems": 5,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "statuses": {
      "minItems": 5,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema3"
      }
    },
    "reactions": {
      "minItems": 10,
      "maxItems": 10,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema7"
      }
    },
    "statusApplications": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema2"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "duration": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99,
            "$ref": "#/$defs/__schema5"
          },
          "hit": {
            "type": "string",
            "enum": [
              "always",
              "seal"
            ]
          }
        },
        "required": [
          "duration"
        ],
        "additionalProperties": false
      }
    },
    "resources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema8"
      }
    },
    "reactionResource": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema2"
        },
        "amount": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "$ref": "#/$defs/__schema5"
        },
        "maxGainPerAction": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "id",
        "amount",
        "maxGainPerAction"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "formatVersion",
    "contentRevision",
    "elements",
    "statuses",
    "reactions",
    "statusApplications",
    "resources",
    "reactionResource"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "element": {
          "$ref": "#/$defs/__schema1"
        },
        "markId": {
          "$ref": "#/$defs/__schema2"
        },
        "skillId": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "element",
        "markId",
        "skillId"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "string",
      "enum": [
        "wood",
        "fire",
        "earth",
        "metal",
        "water"
      ]
    },
    "__schema2": {
      "type": "string",
      "pattern": "^tianyan\\.[a-z][a-z0-9_.]*$"
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema2"
        },
        "name": {
          "$ref": "#/$defs/__schema4"
        },
        "kind": {
          "$ref": "#/$defs/__schema2"
        },
        "category": {
          "type": "string",
          "enum": [
            "buff",
            "debuff",
            "control",
            "dot"
          ]
        },
        "ticks": {
          "type": "string",
          "enum": [
            "roundEnd"
          ]
        },
        "onTick": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "dot"
            },
            "ratioOfMaxHp": {
              "maximum": 1,
              "$ref": "#/$defs/__schema5"
            }
          },
          "required": [
            "type",
            "ratioOfMaxHp"
          ],
          "additionalProperties": false
        },
        "speedMod": {
          "$ref": "#/$defs/__schema6"
        },
        "attrMods": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "hp",
              "maxHp",
              "mp",
              "maxMp",
              "physicalAtk",
              "physicalDef",
              "magicAtk",
              "magicDef",
              "healPower",
              "speed",
              "hit",
              "dodge",
              "critRate",
              "spellCritRate",
              "physicalFuryRate",
              "sealHit",
              "sealResist",
              "attackCultivate",
              "defenseCultivate",
              "spellCultivate",
              "resistSpellCultivate"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema6"
          }
        },
        "blocksAction": {
          "type": "boolean"
        },
        "blocksSpell": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "category"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "__schema5": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000
    },
    "__schema6": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      ]
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema2"
        },
        "name": {
          "$ref": "#/$defs/__schema4"
        },
        "kind": {
          "type": "string",
          "enum": [
            "generate",
            "overcome"
          ]
        },
        "oldElement": {
          "$ref": "#/$defs/__schema1"
        },
        "newElement": {
          "$ref": "#/$defs/__schema1"
        },
        "mainFactor": {
          "$ref": "#/$defs/__schema5"
        },
        "defenseIgnore": {
          "maximum": 1,
          "$ref": "#/$defs/__schema5"
        },
        "followPower": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "statusId": {
          "$ref": "#/$defs/__schema2"
        },
        "healingPower": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "oldElement",
        "newElement"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema2"
        },
        "name": {
          "$ref": "#/$defs/__schema4"
        },
        "current": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "$ref": "#/$defs/__schema5"
        },
        "max": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "id",
        "name",
        "current",
        "max"
      ],
      "additionalProperties": false
    }
  }
}
