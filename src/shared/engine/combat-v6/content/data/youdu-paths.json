  "paths": [
    {
      "id": "youdu.path.soul_judge",
      "name": "拘魂锁命",
      "requiresConnectedNodes": true,
      "foundationPassives": [],
      "nodes": [
        {
          "id": "youdu.node.soul_judge.yanluo",
          "name": "断魂",
          "layer": 1,
          "slot": 1,
          "description": "与怪物队伍战斗时，裂魂咒增加武器伤害贡献×15%的伤害。敌方非召唤物阵亡后，下次灭魂杀伤害提高50%。",
          "passives": [
            "youdu.passive.yanluo"
          ]
        },
        {
          "id": "youdu.node.soul_judge.recoil",
          "name": "护魂",
          "layer": 1,
          "slot": 2,
          "description": "受到的法术伤害（含固定伤害法术）减少65点。",
