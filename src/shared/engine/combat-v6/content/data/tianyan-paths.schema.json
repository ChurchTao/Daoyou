{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "contentRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "passives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "modifiers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "when": {
                  "$ref": "#/$defs/__schema1"
                },
                "damageBonus": {
                  "$ref": "#/$defs/__schema2"
                },
                "defenseIgnoreAdd": {
                  "$ref": "#/$defs/__schema2"
                },
                "barrierDamageBonus": {
                  "$ref": "#/$defs/__schema2"
                },
                "damageTakenBonus": {
                  "$ref": "#/$defs/__schema2"
                },
                "sealChanceAdd": {
                  "$ref": "#/$defs/__schema2"
                }
              },
              "additionalProperties": false
            }
          },
          "hooks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "on": {
                  "type": "string",
                  "enum": [
                    "beforeAction",
                    "onHitCalc",
                    "onDefenseIgnoreCalc",
                    "onBeHit",
                    "afterHit",
                    "afterStrike",
                    "onFatal",
                    "onStatusRemoved",
                    "onDeath",
                    "onRoundStart",
                    "onRoundEnd",
                    "onTargetLost",
                    "afterAction",
                    "onCritRoll",
                    "onHitRoll",
                    "onHealCalc",
                    "onBarrierCalc",
                    "onWoundCalc"
                  ]
                },
                "sourceIsSelf": {
                  "type": "boolean"
                },
                "targetIsSelf": {
                  "type": "boolean"
                },
                "aim": {
                  "type": "string",
                  "enum": [
                    "self",
                    "hookTarget",
                    "hookSource",
                    "others"
                  ]
                },
                "when": {
                  "$ref": "#/$defs/__schema1"
                },
                "effects": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "when": {
                            "$ref": "#/$defs/__schema3"
                          },
                          "targeting": {
                            "$ref": "#/$defs/__schema4"
                          },
                          "type": {
                            "type": "string",
                            "const": "spellHit"
                          },
                          "coeff": {
                            "type": "number"
                          },
                          "power": {
                            "$ref": "#/$defs/__schema2"
                          },
                          "defenseIgnore": {
                            "$ref": "#/$defs/__schema2"
                          }
                        },
                        "required": [
                          "type",
                          "coeff",
                          "power"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "when": {
                            "$ref": "#/$defs/__schema3"
                          },
                          "targeting": {
                            "$ref": "#/$defs/__schema4"
                          },
                          "type": {
                            "type": "string",
                            "const": "applyStatus"
                          },
                          "statusId": {
                            "$ref": "#/$defs/__schema0"
                          },
                          "duration": {
                            "$ref": "#/$defs/__schema2"
                          },
                          "hit": {
                            "type": "string",
                            "enum": [
                              "always",
                              "seal"
                            ]
                          }
                        },
                        "required": [
                          "type",
                          "statusId",
                          "duration"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "when": {
                            "$ref": "#/$defs/__schema3"
                          },
                          "targeting": {
                            "$ref": "#/$defs/__schema4"
                          },
                          "type": {
                            "type": "string",
                            "const": "applyBarrier"
                          },
                          "id": {
                            "$ref": "#/$defs/__schema0"
                          },
                          "kind": {
                            "$ref": "#/$defs/__schema0"
                          },
                          "name": {
                            "type": "string"
                          },
                          "power": {
                            "$ref": "#/$defs/__schema2"
                          },
                          "duration": {
                            "$ref": "#/$defs/__schema2"
                          }
                        },
                        "required": [
                          "type",
                          "id",
                          "kind",
                          "name",
                          "power",
                          "duration"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "when": {
                            "$ref": "#/$defs/__schema3"
                          },
                          "targeting": {
                            "$ref": "#/$defs/__schema4"
                          },
                          "type": {
                            "type": "string",
                            "const": "heal"
                          },
                          "power": {
                            "$ref": "#/$defs/__schema2"
                          },
                          "includeHealPower": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "type",
                          "power"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "when": {
                            "$ref": "#/$defs/__schema3"
                          },
                          "targeting": {
                            "$ref": "#/$defs/__schema4"
                          },
                          "type": {
                            "type": "string",
                            "const": "restoreMp"
                          },
                          "power": {
                            "$ref": "#/$defs/__schema2"
                          }
                        },
                        "required": [
                          "type",
                          "power"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "when": {
                            "$ref": "#/$defs/__schema3"
                          },
                          "targeting": {
                            "$ref": "#/$defs/__schema4"
                          },
                          "type": {
                            "type": "string",
                            "const": "dispel"
                          },
                          "categories": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "buff",
                                "debuff",
                                "control",
                                "dot"
                              ]
                            }
                          },
                          "maxCount": {
                            "$ref": "#/$defs/__schema2"
                          },
                          "excludeStatusFlags": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "blocksAction",
                                "blocksSpell",
                                "blocksPhysical",
                                "blocksRevive",
                                "actFirst",
                                "untargetable",
                                "revealStealth",
                                "persistWhenDowned"
                              ]
                            }
                          }
                        },
                        "required": [
                          "type",
                          "categories",
                          "maxCount"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "when": {
                            "$ref": "#/$defs/__schema3"
                          },
                          "targeting": {
                            "$ref": "#/$defs/__schema4"
                          },
                          "type": {
                            "type": "string",
                            "const": "emitMechanic"
                          },
                          "mechanicId": {
                            "$ref": "#/$defs/__schema0"
                          },
                          "name": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "mechanicId",
                          "name"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "required": [
                "on",
                "effects"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "paths": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema5"
      }
    }
  },
  "required": [
    "formatVersion",
    "contentRevision",
    "passives",
    "paths"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^tianyan\\.[a-z][a-z0-9_.]*$"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "expression": {
          "$ref": "#/$defs/__schema2"
        },
        "requireStatusIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "sourceInitialStatusIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "skillIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "requireKind": {
          "type": "string",
          "enum": [
            "physical",
            "spell",
            "fixed"
          ]
        },
        "damageOrigins": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "action-direct",
              "hook-derived",
              "status"
            ]
          }
        },
        "targetSlot": {
          "type": "string",
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "sourceHasBarrier": {
          "type": "boolean"
        },
        "targetHasBarrier": {
          "type": "boolean"
        },
        "sourceHpRatioBelow": {
          "type": "number"
        },
        "targetHpRatioAbove": {
          "type": "number"
        },
        "targetStatusIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "additionalProperties": false
    },
    "__schema2": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      ]
    },
    "__schema3": {
      "$ref": "#/$defs/__schema1"
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "side": {
          "type": "string",
          "enum": [
            "enemy",
            "ally",
            "self",
            "any"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "explicit",
            "fill",
            "all",
            "random",
            "lowestHp",
            "lowestDef"
          ]
        },
        "count": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "side"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "requiresConnectedNodes": {
          "type": "boolean",
          "const": true
        },
        "foundationPassives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "nodes": {
          "minItems": 21,
          "maxItems": 21,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema6"
          }
        }
      },
      "required": [
        "id",
        "name",
        "requiresConnectedNodes",
        "foundationPassives",
        "nodes"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "slot": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "passives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "grantSkills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "patches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "skillId": {
                "$ref": "#/$defs/__schema0"
              },
              "operation": {
                "type": "string",
                "const": "setCooldownRounds"
              },
              "value": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "skillId",
              "operation",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "layer",
        "slot",
        "passives"
      ],
      "additionalProperties": false
    }
  }
}
