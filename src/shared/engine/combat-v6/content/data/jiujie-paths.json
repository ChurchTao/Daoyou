{
  "$schema": "./jiujie-paths.schema.json",
  "formatVersion": 1,
  "contentRevision": 3,
  "passives": [
    {
      "id": "jiujie.passive.physical",
      "name": "以身承雷",
      "description": "以身承雷，以兵行劫。可直接选择震岳、掠霆的一至三重；灌注能强化本次重数，高重数需承担休息风险。物理伤害提高10%，法术伤害降低15%，封印命中概率乘以85%。",
      "modifiers": [
        {
          "when": {
            "requireKind": "physical"
          },
          "damageBonus": 0.1
        },
        {
          "when": {
            "requireKind": "spell"
          },
          "damageBonus": -0.15
        },
        {
          "sealChanceFactor": 0.85
        }
      ]
    },
    {
      "id": "jiujie.passive.magic",
      "name": "以印引劫",
      "hooks": [
        {
          "on": "onRoundStart",
          "effects": [
            {
              "type": "applyStatus",
              "statusId": "jiujie.status.attunement",
              "duration": 1,
              "self": true
            }
          ],
          "when": {
            "oncePerBattle": true
          }
        },
        {
          "on": "afterStrike",
          "effects": [
            {
              "type": "removeStatus",
              "kinds": [
                "jiujie.status.red"
              ],
              "ownedOnly": true
            },
            {
              "type": "applyStatus",
              "statusId": "jiujie.status.electric",
              "duration": 3
            }
          ],
          "when": {
            "targetOwnedStatus": {
              "kind": "jiujie.status.red"
            }
          },
          "sourceIsSelf": true
        },
        {
          "on": "afterStrike",
          "effects": [
            {
              "type": "randomBranch",
              "branchId": "jiujie.branch.red_mark",
              "chance": "known.jiujie.passive.chiji * if(allyTagCount.sect.jiujie == 1, 0.1, 0)",
              "successEffects": [
                {
                  "type": "removeStatus",
                  "kinds": [
                    "jiujie.status.electric"
                  ],
                  "ownedOnly": true
                },
                {
                  "type": "applyStatus",
                  "statusId": "jiujie.status.red",
                  "duration": 3
                }
              ],
              "failureEffects": [
                {
                  "type": "removeStatus",
                  "kinds": [
                    "jiujie.status.red"
                  ],
                  "ownedOnly": true
                },
                {
                  "type": "applyStatus",
                  "statusId": "jiujie.status.electric",
                  "duration": 3
                }
              ]
            }
          ],
          "when": {
            "skillIds": [
              "jiujie.skill.thunderstorm",
              "jiujie.skill.edict",
              "jiujie.skill.six_thunder"
            ],
            "targetEnemy": true,
            "sourceStanding": true
          },
          "sourceIsSelf": true
        }
      ],
      "modifiers": [
        {
          "sealChanceFactor": 0.85
        },
        {
          "when": {
            "requireKind": "spell",
            "targetOwnedStatus": {
              "kind": "jiujie.status.electric"
            },
            "expression": "1 - ownedTargetStatus.jiujie.status.red"
          },
          "damageBonus": 0.12
        },
        {
          "when": {
            "requireKind": "spell",
            "targetOwnedStatus": {
              "kind": "jiujie.status.red"
            }
          },
          "damageBonus": 0.7
        }
      ],
      "description": "群雷命中后留下持续3回合的雷印，自身后续对其造成的法术伤害提高12%；自身封印命中率降低15%。"
    },
    {
      "id": "jiujie.passive.tingzhen",
      "name": "霆震",
      "modifiers": [
        {
          "when": {
            "skillIds": [
              "jiujie.skill.strike_1",
              "jiujie.skill.strike_2",
              "jiujie.skill.strike_3",
              "jiujie.skill.sweep_1",
              "jiujie.skill.sweep_2",
              "jiujie.skill.sweep_3",
              "jiujie.skill.tribulation"
            ],
            "requireKind": "physical",
            "expression": "(fact.jiujie_type == 2) * (effective.speed > targetEffective.speed)"
          },
          "damageBonus": 0.08
        }
      ],
      "description": "掠霆攻击速度低于自己的目标时，伤害提高8%。"
    },
    {
      "id": "jiujie.passive.jilei",
      "name": "疾雷",
      "modifiers": [
        {
          "when": {
            "skillIds": [
              "jiujie.skill.strike_1",
              "jiujie.skill.strike_2",
              "jiujie.skill.strike_3",
              "jiujie.skill.sweep_1",
              "jiujie.skill.sweep_2",
              "jiujie.skill.sweep_3",
              "jiujie.skill.tribulation"
            ],
            "requireKind": "physical",
            "expression": "(fact.jiujie_type == 1) * (fact.jiujie_rank >= 2) * (fact.jiujie_streak >= 2)"
          },
          "defenseIgnoreAdd": 0.1
        }
      ],
      "description": "连续两次使用二重及以上核心招式而未休息后，震岳忽略10%物防，掠霆基础休息率降低10个百分点，直至休息。"
    },
    {
      "id": "jiujie.passive.jiyue",
      "name": "激越",
      "modifiers": [
        {
          "when": {
            "skillIds": [
              "jiujie.skill.strike_1",
              "jiujie.skill.strike_2",
              "jiujie.skill.strike_3",
              "jiujie.skill.sweep_1",
              "jiujie.skill.sweep_2",
              "jiujie.skill.sweep_3",
              "jiujie.skill.tribulation"
            ],
            "requireKind": "physical",
