{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "contentRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "baseSkillIds": {
      "minItems": 7,
      "maxItems": 7,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "elemental": {
      "minItems": 5,
      "maxItems": 5,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    }
  },
  "required": [
    "formatVersion",
    "contentRevision",
    "baseSkillIds",
    "elemental",
    "skills"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^tianyan\\.[a-z][a-z0-9_.]*$"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "element": {
          "type": "string",
          "enum": [
            "wood",
            "fire",
            "earth",
            "metal",
            "water"
          ]
        },
        "skill": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "element",
        "skill"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "school": {
          "type": "string",
          "const": "tianyan"
        },
        "costMp": {
          "$ref": "#/$defs/__schema3"
        },
        "cooldownRounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requirement": {
          "$ref": "#/$defs/__schema3"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "physical",
              "spell",
              "seal",
              "support",
              "passive",
              "art"
            ]
          }
        },
        "formula": {
          "type": "string",
          "const": "spell"
        },
        "sealBase": {
          "type": "number"
        },
        "targeting": {
          "$ref": "#/$defs/__schema4"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema5"
          }
        },
        "successEffects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema5"
          }
        },
        "modifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "when": {
                "$ref": "#/$defs/__schema7"
              },
              "damageBonus": {
                "$ref": "#/$defs/__schema3"
              },
              "defenseIgnoreAdd": {
                "$ref": "#/$defs/__schema3"
              },
              "barrierDamageBonus": {
                "$ref": "#/$defs/__schema3"
              },
              "damageTakenBonus": {
                "$ref": "#/$defs/__schema3"
              },
              "sealChanceAdd": {
                "$ref": "#/$defs/__schema3"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "school",
        "costMp",
        "tags",
        "targeting",
        "effects"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      ]
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "side": {
          "type": "string",
          "enum": [
            "enemy",
            "ally",
            "self",
            "any"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "explicit",
            "fill",
            "all",
            "random",
            "lowestHp",
            "lowestDef"
          ]
        },
        "count": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "side"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "when": {
              "$ref": "#/$defs/__schema6"
            },
            "targeting": {
              "$ref": "#/$defs/__schema8"
            },
            "type": {
              "type": "string",
              "const": "spellHit"
            },
            "coeff": {
              "type": "number"
            },
            "power": {
              "$ref": "#/$defs/__schema3"
            },
            "defenseIgnore": {
              "$ref": "#/$defs/__schema3"
            }
          },
          "required": [
            "type",
            "coeff",
            "power"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "when": {
              "$ref": "#/$defs/__schema6"
            },
            "targeting": {
              "$ref": "#/$defs/__schema8"
            },
            "type": {
              "type": "string",
              "const": "applyStatus"
            },
            "statusId": {
              "$ref": "#/$defs/__schema0"
            },
            "duration": {
              "$ref": "#/$defs/__schema3"
            },
            "hit": {
              "type": "string",
              "enum": [
                "always",
                "seal"
              ]
            }
          },
          "required": [
            "type",
            "statusId",
            "duration"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "when": {
              "$ref": "#/$defs/__schema6"
            },
            "targeting": {
              "$ref": "#/$defs/__schema8"
            },
            "type": {
              "type": "string",
              "const": "applyBarrier"
            },
            "id": {
              "$ref": "#/$defs/__schema0"
            },
            "kind": {
              "$ref": "#/$defs/__schema0"
            },
            "name": {
              "type": "string"
            },
            "power": {
              "$ref": "#/$defs/__schema3"
            },
            "duration": {
              "$ref": "#/$defs/__schema3"
            }
          },
          "required": [
            "type",
            "id",
            "kind",
            "name",
            "power",
            "duration"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "when": {
              "$ref": "#/$defs/__schema6"
            },
            "targeting": {
              "$ref": "#/$defs/__schema8"
            },
            "type": {
              "type": "string",
              "const": "heal"
            },
            "power": {
              "$ref": "#/$defs/__schema3"
            },
            "includeHealPower": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "power"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "when": {
              "$ref": "#/$defs/__schema6"
            },
            "targeting": {
              "$ref": "#/$defs/__schema8"
            },
            "type": {
              "type": "string",
              "const": "restoreMp"
            },
            "power": {
              "$ref": "#/$defs/__schema3"
            }
          },
          "required": [
            "type",
            "power"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "when": {
              "$ref": "#/$defs/__schema6"
            },
            "targeting": {
              "$ref": "#/$defs/__schema8"
            },
            "type": {
              "type": "string",
              "const": "dispel"
            },
            "categories": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "buff",
                  "debuff",
                  "control",
                  "dot"
                ]
              }
            },
            "maxCount": {
              "$ref": "#/$defs/__schema3"
            },
            "excludeStatusFlags": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "blocksAction",
                  "blocksSpell",
                  "blocksPhysical",
                  "blocksRevive",
                  "actFirst",
                  "untargetable",
                  "revealStealth",
                  "persistWhenDowned"
                ]
              }
            }
          },
          "required": [
            "type",
            "categories",
            "maxCount"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "when": {
              "$ref": "#/$defs/__schema6"
            },
            "targeting": {
              "$ref": "#/$defs/__schema8"
            },
            "type": {
              "type": "string",
              "const": "emitMechanic"
            },
            "mechanicId": {
              "$ref": "#/$defs/__schema0"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "mechanicId",
            "name"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema6": {
      "$ref": "#/$defs/__schema7"
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "expression": {
          "$ref": "#/$defs/__schema3"
        },
        "requireStatusIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "sourceInitialStatusIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "skillIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "requireKind": {
          "type": "string",
          "enum": [
            "physical",
            "spell",
            "fixed"
          ]
        },
        "damageOrigins": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "action-direct",
              "hook-derived",
              "status"
            ]
          }
        },
        "targetSlot": {
          "type": "string",
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "sourceHasBarrier": {
          "type": "boolean"
        },
        "targetHasBarrier": {
          "type": "boolean"
        },
        "sourceHpRatioBelow": {
          "type": "number"
        },
        "targetHpRatioAbove": {
          "type": "number"
        },
        "targetStatusIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "additionalProperties": false
    },
    "__schema8": {
      "$ref": "#/$defs/__schema4"
    }
  }
}
