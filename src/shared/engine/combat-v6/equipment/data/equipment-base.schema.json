{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "contentRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "templates": {
      "minItems": 6,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^dao_equipment\\.standard\\.[a-z]+\\.v1$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "slot": {
            "type": "string",
            "enum": [
              "weapon",
              "head",
              "armor",
              "necklace",
              "belt",
              "footwear"
            ]
          },
          "baseStats": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "attr": {
                  "type": "string",
                  "enum": [
                    "physicalAtk",
                    "physicalDef",
                    "magicAtk",
                    "magicDef",
                    "maxHp",
                    "maxMp",
                    "healPower",
                    "speed",
                    "hit",
                    "dodge",
                    "critRate",
                    "spellCritRate",
                    "physicalFuryRate",
                    "sealHit",
                    "sealResist"
                  ]
                },
                "ranges": {
                  "minItems": 5,
                  "maxItems": 5,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "level": {
                        "anyOf": [
                          {
                            "type": "number",
                            "const": 10
                          },
                          {
                            "type": "number",
                            "const": 30
                          },
                          {
                            "type": "number",
                            "const": 50
                          },
                          {
                            "type": "number",
                            "const": 70
                          },
                          {
                            "type": "number",
                            "const": 90
                          }
                        ]
                      },
                      "normal": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1000000
                          },
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1000000
                          }
                        ]
                      },
                      "enhanced": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1000000
                          },
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1000000
                          }
                        ]
                      }
                    },
                    "required": [
                      "level",
                      "normal",
                      "enhanced"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "attr",
                "ranges"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "slot",
          "baseStats"
        ],
        "additionalProperties": false
      }
    },
    "inscriptions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^dao_inscription\\.[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "attr": {
            "type": "string",
            "enum": [
              "physicalAtk",
              "physicalDef",
              "magicAtk",
              "magicDef",
              "maxHp",
              "maxMp",
              "healPower",
              "speed",
              "hit",
              "dodge",
              "critRate",
              "spellCritRate",
              "physicalFuryRate",
              "sealHit",
              "sealResist"
            ]
          },
          "valuePerLevel": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "allowedSlots": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "weapon",
                "head",
                "armor",
                "necklace",
                "belt",
                "footwear"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "attr",
          "valuePerLevel",
          "allowedSlots"
        ],
        "additionalProperties": false
      }
    },
    "generation": {
      "type": "object",
      "properties": {
        "bonusCountProbabilities": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ]
        },
        "bonusRanges": {
          "minItems": 5,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "level": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 10
                  },
                  {
                    "type": "number",
                    "const": 30
                  },
                  {
                    "type": "number",
                    "const": 50
                  },
                  {
                    "type": "number",
                    "const": 70
                  },
                  {
                    "type": "number",
                    "const": 90
                  }
                ]
              },
              "min": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "max": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "level",
              "min",
              "max"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "bonusCountProbabilities",
        "bonusRanges"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "formatVersion",
    "contentRevision",
    "templates",
    "inscriptions",
    "generation"
  ],
  "additionalProperties": false
}
