{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "contentRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "generation": {
      "type": "object",
      "properties": {
        "essenceCountProbabilities": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ]
        },
        "artChance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "essencePool": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artPool": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "essenceCountProbabilities",
        "artChance",
        "essencePool",
        "artPool"
      ],
      "additionalProperties": false
    },
    "forging": {
      "type": "object",
      "properties": {
        "boostPerMaterial": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2,
          "multipleOf": 0.000001
        },
        "costs": {
          "minItems": 9,
          "maxItems": 9,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "level": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 10
                  },
                  {
                    "type": "number",
                    "const": 30
                  },
                  {
                    "type": "number",
                    "const": 50
                  },
                  {
                    "type": "number",
                    "const": 70
                  },
                  {
                    "type": "number",
                    "const": 90
                  },
                  {
                    "type": "number",
                    "const": 110
                  },
                  {
                    "type": "number",
                    "const": 130
                  },
                  {
                    "type": "number",
                    "const": 150
                  },
                  {
                    "type": "number",
                    "const": 170
                  }
                ]
              },
              "spiritStones": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000000
              },
              "qi": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "rank": {
                "type": "string",
                "enum": [
                  "凡品",
                  "灵品",
                  "玄品",
                  "真品",
                  "地品",
                  "天品",
                  "仙品",
                  "神品"
                ]
              }
            },
            "required": [
              "level",
              "spiritStones",
              "qi",
              "quantity",
              "rank"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "boostPerMaterial",
        "costs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "formatVersion",
    "contentRevision",
    "generation",
    "forging"
  ],
  "additionalProperties": false
}
