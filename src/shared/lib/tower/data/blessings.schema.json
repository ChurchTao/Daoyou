{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "number",
      "const": 2
    },
    "contentRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "blessings": {
      "minItems": 5,
      "maxItems": 5,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "choices": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "required": [
        "count"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "formatVersion",
    "contentRevision",
    "blessings",
    "choices"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "physical_power",
            "spell_power",
            "guard",
            "swiftness",
            "beast_power"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "maxStacks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "effect": {
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "enum": [
                "player",
                "beasts"
              ]
            },
            "attributes": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema1"
              }
            },
            "perStack": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 0.1
            }
          },
          "required": [
            "target",
            "attributes",
            "perStack"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "name",
        "icon",
        "label",
        "maxStacks",
        "effect"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "string",
      "enum": [
        "physicalAtk",
        "magicAtk",
        "physicalDef",
        "magicDef",
        "speed"
      ]
    }
  }
}
