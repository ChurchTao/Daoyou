{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "contentRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "minRealm": {
      "type": "string",
      "enum": [
        "炼气",
        "筑基",
        "金丹",
        "元婴",
        "化神",
        "炼虚",
        "合体",
        "大乘",
        "渡劫"
      ]
    },
    "difficultyStep": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "$ref": "#/$defs/__schema0"
    },
    "floors": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "enemies": {
      "type": "object",
      "properties": {
        "floorGrowth": {
          "$ref": "#/$defs/__schema0"
        },
        "hpBase": {
          "$ref": "#/$defs/__schema0"
        },
        "hpPerLevel": {
          "$ref": "#/$defs/__schema0"
        },
        "attackBase": {
          "$ref": "#/$defs/__schema0"
        },
        "attackPerLevel": {
          "$ref": "#/$defs/__schema0"
        },
        "defensePerLevel": {
          "$ref": "#/$defs/__schema0"
        },
        "speedPerLevel": {
          "$ref": "#/$defs/__schema0"
        },
        "templates": {
          "type": "object",
          "properties": {
            "normal": {
              "$ref": "#/$defs/__schema2"
            },
            "elite": {
              "$ref": "#/$defs/__schema2"
            },
            "boss": {
              "$ref": "#/$defs/__schema2"
            }
          },
          "required": [
            "normal",
            "elite",
            "boss"
          ],
          "additionalProperties": false
        },
        "baseAttrs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "hp",
              "maxHp",
              "mp",
              "maxMp",
              "physicalAtk",
              "physicalDef",
              "magicAtk",
              "magicDef",
              "healPower",
              "speed",
              "hit",
              "dodge",
              "critRate",
              "spellCritRate",
              "physicalFuryRate",
              "sealHit",
              "sealResist",
              "attackCultivate",
              "defenseCultivate",
              "spellCultivate",
              "resistSpellCultivate"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          },
          "required": [
            "hp",
            "maxHp",
            "mp",
            "maxMp",
            "physicalAtk",
            "physicalDef",
            "magicAtk",
            "magicDef",
            "healPower",
            "speed",
            "hit",
            "dodge",
            "critRate",
            "spellCritRate",
            "physicalFuryRate",
            "sealHit",
            "sealResist",
            "attackCultivate",
            "defenseCultivate",
            "spellCultivate",
            "resistSpellCultivate"
          ]
        }
      },
      "required": [
        "floorGrowth",
        "hpBase",
        "hpPerLevel",
        "attackBase",
        "attackPerLevel",
        "defensePerLevel",
        "speedPerLevel",
        "templates",
        "baseAttrs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "formatVersion",
    "contentRevision",
    "minRealm",
    "difficultyStep",
    "floors",
    "enemies"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "floor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "kind": {
          "type": "string",
          "enum": [
            "normal",
            "elite",
            "boss"
          ]
        },
        "realmStage": {
          "type": "string",
          "enum": [
            "初期",
            "中期",
            "后期",
            "圆满"
          ]
        },
        "milestone": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "C",
                "B",
                "A",
                "S"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "floor",
        "kind",
        "realmStage",
        "milestone"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "hpScale": {
          "exclusiveMinimum": 0,
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "name",
        "count",
        "hpScale"
      ],
      "additionalProperties": false
    }
  }
}
