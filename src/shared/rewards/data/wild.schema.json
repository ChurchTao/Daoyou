{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "contentRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "nodeId": {
      "type": "string",
      "minLength": 1
    },
    "poolId": {
      "type": "string",
      "minLength": 1
    },
    "poolVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "equipmentLevels": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "groups": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    }
  },
  "required": [
    "formatVersion",
    "contentRevision",
    "nodeId",
    "poolId",
    "poolVersion",
    "equipmentLevels",
    "groups"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "integer",
      "minimum": 10,
      "maximum": 180,
      "multipleOf": 10
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "fixed"
                },
                "entries": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema2"
                  }
                }
              },
              "required": [
                "kind",
                "entries"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "equipment",
                    "blueprints"
                  ]
                },
                "slots": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema3"
                  }
                }
              },
              "required": [
                "kind",
                "slots"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "manualJades"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "chance",
        "source"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "rewardId": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "quantity": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "rewardId",
        "weight",
        "quantity"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "string",
      "enum": [
        "weapon",
        "head",
        "armor",
        "necklace",
        "belt",
        "footwear"
      ]
    }
  }
}
