{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "number",
      "const": 2
    },
    "contentRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "poolId": {
      "type": "string",
      "minLength": 1
    },
    "poolVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "groups": {
      "minItems": 1,
      "maxItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": [
    "formatVersion",
    "contentRevision",
    "poolId",
    "poolVersion",
    "groups"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "const": "books"
        },
        "chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "fixed"
            },
            "entries": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema1"
              }
            }
          },
          "required": [
            "kind",
            "entries"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "chance",
        "source"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "rewardId": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "quantity": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number",
              "const": 1
            },
            "max": {
              "type": "number",
              "const": 1
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "rewardId",
        "weight",
        "quantity"
      ],
      "additionalProperties": false
    }
  }
}
