{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "contentRevision": {
      "minimum": 1,
      "$ref": "#/$defs/__schema0"
    },
    "materials": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "milestones": {
      "type": "object",
      "properties": {
        "C": {
          "$ref": "#/$defs/__schema2"
        },
        "B": {
          "$ref": "#/$defs/__schema2"
        },
        "A": {
          "$ref": "#/$defs/__schema2"
        },
        "S": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "C",
        "B",
        "A",
        "S"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "formatVersion",
    "contentRevision",
    "materials",
    "milestones"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "rewardId": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "minimum": 1,
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "rewardId",
        "weight"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "quantity": {
          "minimum": 1,
          "$ref": "#/$defs/__schema0"
        },
        "spiritStonesPerLevel": {
          "$ref": "#/$defs/__schema0"
        },
        "reputation": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "quantity",
        "spiritStonesPerLevel",
        "reputation"
      ],
      "additionalProperties": false
    }
  }
}
