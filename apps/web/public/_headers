# Keep Cache-Control values in step with the repository-root edgeone.json.
# Paths that set Cache-Control do not overlap: Cloudflare joins repeated
# Cache-Control values instead of replacing them.
#
# A rule matches the request path, including when the body is a 404.
# Hashed bundles therefore use s-maxage so the edge drops a bad response
# within a minute, while browsers may keep a real file for a year.

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate

/version.json
  Cache-Control: no-store

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Vite content hashes. immutable is for browsers. s-maxage is for the edge.
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable, s-maxage=60

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable, s-maxage=60

# Public images are replaced in place and are not content-hashed.
/assets/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/*.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/licenses/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*
  X-Frame-Options: DENY
