{
  "name": "wanjiedaoyou",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "alchemy:formulas:v4": "bun run scripts/migrate-alchemy-formulas-v4.ts",
    "alchemy:formulas:v4:dry-run": "bun run scripts/migrate-alchemy-formulas-v4.ts --dry-run",
    "auth:generate": "bunx drizzle-kit generate --config drizzle.auth.config.ts",
    "auth:info": "bunx --bun auth@latest info --config src/server/lib/auth/auth.ts --json",
    "auth:migrate": "bunx drizzle-kit migrate --config drizzle.auth.config.ts",
    "battle:e2e:redis": "bun run scripts/online-battle-redis-e2e.ts",
    "battle:smoke": "bun run scripts/online-battle-smoke.ts && bun run scripts/online-battle-worker-smoke.ts",
    "build": "bun run build:client && bun run build:server",
    "build:client": "tsc -b tsconfig.app.json && vite build --mode client",
    "build:server": "tsc -b tsconfig.node.json && vite build --mode server && vite build --config vite.battle-worker.config.ts",
    "dev": "bun run --parallel dev:api dev:web",
    "dev:api": "bun run --watch src/index.ts",
    "dev:web": "vite",
    "lint": "eslint .",
    "sponsors:check": "bun run scripts/render-sponsors.ts --check",
    "sponsors:fetch": "node ./node_modules/sponsorkit/dist/cli.mjs --force",
    "sponsors:render": "bun run scripts/render-sponsors.ts",
    "sponsors:sync": "bun run sponsors:fetch && bun run sponsors:render && bun run sponsors:check",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "^2.0.45",
    "@ai-sdk/deepseek": "^3.0.44",
    "@better-auth/drizzle-adapter": "^1.7.4",
    "@better-auth/i18n": "^1.7.4",
    "@microfleet/ioredis-lock": "^6.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "ai": "^7.0.99",
    "altcha": "^3.2.2",
    "altcha-lib": "^2.5.0",
    "better-auth": "^1.7.4",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-format": "^3.1.2",
    "drizzle-orm": "^0.45.2",
    "hono": "4.13.7",
    "ioredis": "^5.11.1",
    "nats": "^2.29.3",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "phaser": "^4.2.1",
    "phaser4-rex-plugins": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^8.3.1",
    "react-zoom-pan-pinch": "^4.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hono/vite-build": "1.11.1",
    "@types/bun": "1.4.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-format": "^3.0.4",
    "@types/node": "^26.5.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sponsorkit": "^18.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
