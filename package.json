{
  "name": "wanjiedaoyou",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "alchemy:formulas:v4": "bun run scripts/migrate-alchemy-formulas-v4.ts",
    "alchemy:formulas:v4:dry-run": "bun run scripts/migrate-alchemy-formulas-v4.ts --dry-run",
    "auth:generate": "bunx drizzle-kit generate --config drizzle.auth.config.ts",
    "auth:info": "bunx --bun auth@latest info --config src/server/lib/auth/auth.ts --json",
    "auth:migrate": "bunx drizzle-kit migrate --config drizzle.auth.config.ts",
    "build": "bun run --sequential build:client build:server",
    "build:client": "tsc -b tsconfig.app.json && vite build",
    "build:server": "tsc -b tsconfig.node.json && vite build --config vite.server.config.ts",
    "db:migrate": "bun --env-file=env/local.env run auth:migrate && bun --env-file=env/local.env x drizzle-kit migrate",
    "dev": "bun run --parallel dev:api dev:web",
    "dev:api": "APP_ENV=local NODE_ENV=development bun --env-file=env/local.env --watch src/index.ts",
    "dev:web": "NODE_ENV=development bun --env-file=env/local.env run vite",
    "lint": "eslint .",
    "prd": "bun run --parallel prd:api prd:web",
    "prd:api": "APP_ENV=staging NODE_ENV=development bun --env-file=env/staging.env --watch src/index.ts",
    "prd:web": "NODE_ENV=development bun --env-file=env/staging.env run vite",
    "services": "docker compose --env-file env/local.env -f scripts/docker-compose.local.yml",
    "sponsors:check": "bun run scripts/render-sponsors.ts --check",
    "sponsors:fetch": "node ./node_modules/sponsorkit/dist/cli.mjs --force",
    "sponsors:render": "bun run scripts/render-sponsors.ts",
    "sponsors:sync": "bun run sponsors:fetch && bun run sponsors:render && bun run sponsors:check",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "^2.0.32",
    "@ai-sdk/deepseek": "^3.0.24",
    "@better-auth/drizzle-adapter": "^1.6.26",
    "@better-auth/i18n": "^1.6.26",
    "@microfleet/ioredis-lock": "^6.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "ai": "^7.0.56",
    "altcha": "^3.2.1",
    "altcha-lib": "^2.3.2",
    "better-auth": "^1.6.26",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-format": "^3.1.2",
    "drizzle-orm": "^0.45.2",
    "hono": "4.13.0",
    "ioredis": "^5.11.1",
    "nats": "^2.29.3",
    "nodemailer": "^9.0.4",
    "pg": "^8.22.0",
    "phaser": "^4.2.1",
    "phaser4-rex-plugins": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^8.3.0",
    "react-zoom-pan-pinch": "^4.0.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hono/vite-build": "1.11.1",
    "@types/bun": "1.3.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-format": "^3.0.4",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sponsorkit": "^18.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
