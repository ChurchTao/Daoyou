# Copy to env/local.env. These credentials are only for docker-compose.local.yml.
# Never use APP_ENV=local against remote data or copy real keys into this template.
NODE_ENV=development
APP_ENV=local
HOST=127.0.0.1
PORT=3001
WEB_PORT=5174
DATABASE_URL=postgresql://daoyou:daoyou-local-only@127.0.0.1:15432/daoyou_local
DB_MAX_CONNECTIONS=4
REDIS_URL=redis://127.0.0.1:16379/0
NATS_SERVERS=nats://127.0.0.1:14222
NATS_USER=app
NATS_PASSWORD=local-nats-password
NATS_CLIENT_NAME=daoyou-local
BETTER_AUTH_URL=http://127.0.0.1:5174
BETTER_AUTH_SECRET=daoyou-local-only-auth-secret-do-not-use-in-production
PUBLIC_WEB_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
CRON_SECRET=daoyou-local-only-cron-secret
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
SMTP_SECURE=false
SMTP_USER=local
SMTP_PASS=local
MAIL_FROM=Daoyou Local <noreply@daoyou.local>
SPONSORSHIP_FULFILLMENT_ENABLED=false
# Configure provider credentials only in your ignored env/local.env if needed.
LLM_PROVIDER=
