# Server runtime environment file example.
# Copy to env/staging.env for preproduction or prepare production runtime configuration.
# Pure local development uses env/local.env copied from env/local.example.env.

PORT=3000
APP_ENV=staging
# APP_ENV=local enables unauthenticated /api/dev/resources. Never use it with remote data.

# 阿里云百炼（Qwen）
ALIBABA_API_KEY=your-alibaba-api-key
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key

# 原生 @nestjs/ai 命名模型，全部业务调用均显式选择别名。
# 共用上述供应商 Key 和 ALIBABA_BASE_URL；业务显式选择 provider.fast / provider.advanced。
# FAST_MODEL 留空使用对应供应商默认模型，ADVANCED_MODEL 留空不注册该别名。
# 普通场景用 alibaba.fast；云游大纲、正文和审校用 alibaba.advanced，运行前须配置。
# 不提供 default 别名，也不会自动切换供应商或高级降为快速。
ALIBABA_FAST_MODEL=
ALIBABA_ADVANCED_MODEL=
DEEPSEEK_FAST_MODEL=
DEEPSEEK_ADVANCED_MODEL=

# Persistence, coordination and domain events
DATABASE_URL=postgresql://user:password@db-host:5432/daoyou
DB_MAX_CONNECTIONS=4
REDIS_URL=redis://:password@redis-host:6379/0
# Required. The checked-in local NATS compose file uses these development credentials.
# Production must inject its own credentials and must not reuse this password.
NATS_SERVERS=nats://127.0.0.1:4222
NATS_USER=app
NATS_PASSWORD=local-nats-password
# Optional name shown by the NATS monitoring endpoint.
NATS_CLIENT_NAME=
API_IP_RATE_LIMIT_WINDOW_SECONDS=60
API_IP_RATE_LIMIT_MAX_REQUESTS=300
# Required in production for /internal/cron/* bearer auth and manual backfills.
CRON_SECRET=replace-with-a-random-secret

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-random-secret
BETTER_AUTH_URL=https://api.daoyou.example.com
# Optional: comma-separated API hostnames for multi-domain auth. When set,
# Better Auth resolves its base URL from the request Host header.
# BETTER_AUTH_ALLOWED_HOSTS=api.daoyou.example.com,api.example.org
# Exact frontend origins, comma-separated; no paths or wildcard domains.
PUBLIC_WEB_ORIGINS=https://app.daoyou.example.com
# Set true for different-site frontends calling one HTTPS API directly.
# Requires HTTPS BETTER_AUTH_URL; third-party cookie blocking may prevent login.
BETTER_AUTH_CROSS_SITE_COOKIES=false
# Optional for same-site subdomains only. Leave unset when cross-site cookies are enabled.
# BETTER_AUTH_COOKIE_DOMAIN=.daoyou.example.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Captcha
# 留空或不配置时关闭人机验证；配置后注册、登录等接口强制验证。
ALTCHA_HMAC_SECRET=replace-with-a-random-secret

# Admin
ADMIN_EMAILS=
# Stable Better Auth user IDs allowed to use account-management operations.
ADMIN_USER_IDS=

# Mail
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="万界道友官方 <noreply@example.com>"

# Feature flags
ENABLE_LLM_NAMING=
DISABLE_LLM_NAMING=

# SponsorKit / Afdian synchronization (maintenance and CI only; not app runtime)
SPONSORKIT_AFDIAN_USER_ID=
SPONSORKIT_AFDIAN_TOKEN=
SPONSORKIT_AFDIAN_EXCHANGE_RATE=6.5

# In-game 功德簿 / Afdian Webhook
# Set provider to afdian only after the migration, Redis and NATS are ready.
SPONSORSHIP_PROVIDER=disabled
SPONSORSHIP_FULFILLMENT_ENABLED=false
AFDIAN_USER_ID=
AFDIAN_TOKEN=

# Frontend public build variables
# Configure these in GitHub Actions Environment/Repository vars, not in the
# server runtime env file passed to `docker run --env-file`.
# VITE_API_BASE_URL=https://api.daoyou.example.com

# 后台模型任务（云游剧本库、材料库生成）：production 缺省开启，其他环境缺省关闭。
# 开启后启动 API 就会清扫并生成排队任务，持续产生模型费用，只在确实要批量生成时设为 on。
# BACKGROUND_LLM_JOBS=off
